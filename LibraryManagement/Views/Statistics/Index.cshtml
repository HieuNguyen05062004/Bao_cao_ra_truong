@model StatisticsViewModel
@{
    ViewData["Title"] = "Thống kê";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1"><i class="bi bi-graph-up me-2 text-primary"></i>Thống kê thư viện</h4>
    <p class="text-muted mb-0">Tổng quan hoạt động thư viện</p>
</div>

<!-- Summary cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card primary text-center">
            <div class="card-body py-4">
                <i class="bi bi-journals text-primary" style="font-size:2.5rem;"></i>
                <div class="display-6 fw-bold mt-2">@Model.TotalBooks</div>
                <div class="text-muted">Tổng số sách</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card success text-center">
            <div class="card-body py-4">
                <i class="bi bi-person-heart text-success" style="font-size:2.5rem;"></i>
                <div class="display-6 fw-bold mt-2">@Model.TotalReaders</div>
                <div class="text-muted">Bạn đọc</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card warning text-center">
            <div class="card-body py-4">
                <i class="bi bi-journal-bookmark text-warning" style="font-size:2.5rem;"></i>
                <div class="display-6 fw-bold mt-2">@Model.TotalBorrowing</div>
                <div class="text-muted">Đang mượn</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card danger text-center">
            <div class="card-body py-4">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size:2.5rem;"></i>
                <div class="display-6 fw-bold mt-2">@Model.TotalOverdue</div>
                <div class="text-muted">Quá hạn</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Monthly borrow chart -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-bar-chart me-2 text-primary"></i>Thống kê mượn/trả theo tháng</h5>
            </div>
            <div class="card-body">
                <canvas id="borrowChart" height="120"></canvas>
            </div>
        </div>
    </div>

    <!-- Category stats -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-tags me-2 text-warning"></i>Thống kê theo danh mục</h5>
            </div>
            <div class="card-body">
                @foreach (var cat in Model.CategoryStats.OrderByDescending(c => c.BorrowCount).Take(5))
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-truncate me-2">@cat.CategoryName</span>
                        <div class="text-end flex-shrink-0">
                            <span class="badge bg-primary me-1">@cat.BookCount sách</span>
                            <span class="badge bg-secondary">@cat.BorrowCount lượt</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Top books -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-trophy me-2 text-warning"></i>Top sách được mượn nhiều nhất</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Tên sách</th>
                            <th>Tác giả</th>
                            <th>Lượt mượn</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{int rank = 1;}
                        @foreach (var book in Model.TopBorrowedBooks)
                        {
                            <tr>
                                <td>
                                    @if (rank <= 3)
                                    {
                                        <span class="badge bg-@(rank == 1 ? "warning" : rank == 2 ? "secondary" : "danger")">@rank</span>
                                    }
                                    else
                                    {
                                        @rank
                                    }
                                </td>
                                <td class="fw-semibold">@book.Title</td>
                                <td class="text-muted">@book.Author</td>
                                <td><span class="badge bg-primary">@book.BorrowCount</span></td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Summary -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-info"></i>Tóm tắt hoạt động</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded mb-2">
                    <span><i class="bi bi-tags me-2 text-secondary"></i>Danh mục sách</span>
                    <strong>@Model.TotalCategories</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded mb-2">
                    <span><i class="bi bi-person-badge me-2 text-info"></i>Nhân viên</span>
                    <strong>@Model.TotalStaff</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded mb-2">
                    <span><i class="bi bi-check-circle me-2 text-success"></i>Đã trả</span>
                    <strong>@Model.TotalReturned</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center p-3 bg-danger bg-opacity-10 rounded">
                    <span><i class="bi bi-exclamation-circle me-2 text-danger"></i>Đang quá hạn</span>
                    <strong class="text-danger">@Model.TotalOverdue</strong>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const borrowLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBorrowStats.Select(m => m.Label)));
const borrowData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBorrowStats.Select(m => m.Count)));
const returnData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyReturnStats.Select(m => m.Count)));

const ctx = document.getElementById('borrowChart');
new Chart(ctx, {
    type: 'bar',
    data: {
        labels: borrowLabels.length > 0 ? borrowLabels : ['Chưa có dữ liệu'],
        datasets: [
            {
                label: 'Lượt mượn',
                data: borrowData.length > 0 ? borrowData : [0],
                backgroundColor: 'rgba(52, 152, 219, 0.7)',
                borderRadius: 5
            },
            {
                label: 'Lượt trả',
                data: returnData.length > 0 ? returnData : [0],
                backgroundColor: 'rgba(46, 204, 113, 0.7)',
                borderRadius: 5
            }
        ]
    },
    options: {
        responsive: true,
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } },
        plugins: { legend: { position: 'top' } }
    }
});
</script>
}
