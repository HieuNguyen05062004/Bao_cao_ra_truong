@model List<BorrowRecord>
@{
    ViewData["Title"] = "Sách quá hạn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle me-2 text-danger"></i>Sách quá hạn</h4>
        <p class="text-muted mb-0">Tổng: @Model.Count trường hợp quá hạn</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
            <h5 class="mt-3">Không có sách quá hạn!</h5>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-danger">
                    <tr>
                        <th>Bạn đọc</th>
                        <th>Sách</th>
                        <th>Ngày mượn</th>
                        <th>Hạn trả</th>
                        <th>Số ngày quá hạn</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.OrderBy(r => r.DueDate))
                    {
                        var daysOverdue = (DateTime.Today - r.DueDate).Days;
                        <tr>
                            <td>
                                <div class="fw-semibold">@r.User?.FullName</div>
                                <div class="text-muted small">@r.User?.Email</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@r.Book?.Title</div>
                                <div class="text-muted small">@r.Book?.Author</div>
                            </td>
                            <td>@r.BorrowDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-danger fw-bold">@r.DueDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-danger fs-6">@daysOverdue ngày</span></td>
                            <td>
                                <a asp-action="Return" asp-route-id="@r.Id" class="btn btn-sm btn-success">
                                    <i class="bi bi-arrow-return-left me-1"></i>Xác nhận trả
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
