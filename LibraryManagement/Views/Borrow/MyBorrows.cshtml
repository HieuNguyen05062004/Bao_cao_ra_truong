@model List<BorrowRecord>
@{
    ViewData["Title"] = "Sách đang mượn";
    string GetStatusClass(BorrowRecord r) {
        if (r.Status == BorrowStatus.Returned) return "success";
        if (r.Status == BorrowStatus.Overdue) return "danger";
        return r.DueDate < DateTime.Today ? "danger" : "primary";
    }
    string GetStatusLabel(BorrowRecord r) {
        if (r.Status == BorrowStatus.Returned) return "Đã trả";
        if (r.Status == BorrowStatus.Overdue) return "Trả quá hạn";
        return r.DueDate < DateTime.Today ? "Quá hạn" : "Đang mượn";
    }
}

<div class="mb-4">
    <h4 class="fw-bold mb-1"><i class="bi bi-journal-bookmark me-2 text-primary"></i>Sách đang mượn</h4>
    <p class="text-muted mb-0">Tổng: @Model.Count lần mượn</p>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-book text-muted" style="font-size: 4rem;"></i>
            <h5 class="mt-3 text-muted">Bạn chưa mượn sách nào</h5>
            <a asp-controller="Search" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-search me-2"></i>Tìm kiếm sách
            </a>
        </div>
    </div>
}
else
{
    var borrowing = Model.Where(r => r.Status == BorrowStatus.Borrowing).ToList();
    var history = Model.Where(r => r.Status != BorrowStatus.Borrowing).ToList();
    
    if (borrowing.Any())
    {
        <h6 class="fw-bold text-primary mb-3">Đang mượn (@borrowing.Count)</h6>
        <div class="row g-3 mb-4">
            @foreach (var r in borrowing)
            {
                var isOverdue = r.DueDate < DateTime.Today;
                <div class="col-md-6">
                    <div class="card @(isOverdue ? "border-danger" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold mb-1">@r.Book?.Title</h6>
                                    <div class="text-muted small">@r.Book?.Author</div>
                                    <div class="mt-2 d-flex gap-3">
                                        <span class="small"><i class="bi bi-calendar3 me-1"></i>Mượn: @r.BorrowDate.ToString("dd/MM/yyyy")</span>
                                        <span class="small @(isOverdue ? "text-danger fw-bold" : "")">
                                            <i class="bi bi-calendar-x me-1"></i>Hạn: @r.DueDate.ToString("dd/MM/yyyy")
                                        </span>
                                    </div>
                                    @if (isOverdue)
                                    {
                                        <div class="mt-1">
                                            <span class="badge bg-danger">Quá hạn @(DateTime.Today - r.DueDate).Days ngày</span>
                                        </div>
                                    }
                                </div>
                                <span class="badge bg-@GetStatusClass(r) ms-2">@GetStatusLabel(r)</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (history.Any())
    {
        <h6 class="fw-bold text-secondary mb-3">Lịch sử mượn/trả (@history.Count)</h6>
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sách</th>
                            <th>Ngày mượn</th>
                            <th>Ngày trả</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in history)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@r.Book?.Title</div>
                                    <div class="text-muted small">@r.Book?.Author</div>
                                </td>
                                <td>@r.BorrowDate.ToString("dd/MM/yyyy")</td>
                                <td>@(r.ReturnDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td><span class="badge bg-@GetStatusClass(r)">@GetStatusLabel(r)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
