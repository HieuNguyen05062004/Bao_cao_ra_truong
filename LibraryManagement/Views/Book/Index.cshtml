@model List<Book>
@{
    ViewData["Title"] = "Quản lý sách";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-journals me-2 text-primary"></i>Quản lý sách</h4>
        <p class="text-muted mb-0">Tổng số: @Model.Count cuốn sách</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Thêm sách mới
    </a>
</div>

<div class="card">
    <div class="card-header bg-white py-3">
        <div class="row g-2">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm..." />
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <form id="deleteForm" asp-action="DeleteMultiple" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ids" id="selectedIds" />
            <div class="d-flex align-items-center px-3 py-2 border-bottom bg-light">
                <button type="button" class="btn btn-danger btn-sm me-2" id="deleteSelectedBtn" onclick="deleteSelected()" disabled>
                    <i class="bi bi-trash me-1"></i>Xóa đã chọn
                </button>
                <span class="text-muted small" id="selectedCount">Chưa chọn mục nào</span>
            </div>
            <table class="table table-hover mb-0" id="bookTable">
                <thead class="table-light">
                    <tr>
                        <th width="40"><input type="checkbox" id="selectAll" onchange="toggleAll(this)" /></th>
                        <th>Tên sách</th>
                        <th>Tác giả</th>
                        <th>Danh mục</th>
                        <th>Tổng SL</th>
                        <th>Còn lại</th>
                        <th width="150">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td><input type="checkbox" class="row-check" value="@book.Id" onchange="updateSelection()" /></td>
                            <td>
                                <div class="fw-semibold">@book.Title</div>
                                @if (!string.IsNullOrEmpty(book.ISBN))
                                {
                                    <div class="text-muted small">ISBN: @book.ISBN</div>
                                }
                            </td>
                            <td>@book.Author</td>
                            <td><span class="badge bg-secondary">@book.Category?.Name</span></td>
                            <td>@book.TotalQuantity</td>
                            <td>
                                <span class="badge @(book.AvailableQuantity > 0 ? "bg-success" : "bg-danger")">
                                    @book.AvailableQuantity
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-warning" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa"
                                            onclick="confirmDelete(@book.Id, '@book.Title.Replace("'", "\\'")' )">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    </div>
</div>

<!-- Delete single modal -->
<form id="deleteSingleForm" asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteBookId" />
</form>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa sách <strong id="deleteBookTitle"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="document.getElementById('deleteSingleForm').submit()">
                    <i class="bi bi-trash me-1"></i>Xóa
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete multiple confirm modal -->
<div class="modal fade" id="deleteMultiModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="deleteMultiMessage"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="submitDeleteMultiple()">
                    <i class="bi bi-trash me-1"></i>Xóa
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function toggleAll(cb) {
    document.querySelectorAll('.row-check').forEach(c => c.checked = cb.checked);
    updateSelection();
}

function updateSelection() {
    const checks = document.querySelectorAll('.row-check:checked');
    document.getElementById('deleteSelectedBtn').disabled = checks.length === 0;
    document.getElementById('selectedCount').textContent = checks.length > 0 ? `Đã chọn ${checks.length} mục` : 'Chưa chọn mục nào';
}

function deleteSelected() {
    const ids = Array.from(document.querySelectorAll('.row-check:checked')).map(c => c.value);
    document.getElementById('deleteMultiMessage').textContent = `Bạn có chắc chắn muốn xóa ${ids.length} sách đã chọn?`;
    document.getElementById('selectedIds').value = ids.join(',');
    new bootstrap.Modal(document.getElementById('deleteMultiModal')).show();
}

function submitDeleteMultiple() {
    document.getElementById('deleteForm').submit();
}

function confirmDelete(id, title) {
    document.getElementById('deleteBookId').value = id;
    document.getElementById('deleteBookTitle').textContent = title;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}

// Search filter
document.getElementById('searchInput').addEventListener('input', function() {
    const val = this.value.toLowerCase();
    document.querySelectorAll('#bookTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
    });
});
</script>
}
