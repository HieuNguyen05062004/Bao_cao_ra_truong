@model Book
@{
    ViewData["Title"] = "Chi tiết sách";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <h4 class="fw-bold mb-0"><i class="bi bi-book me-2 text-primary"></i>Chi tiết sách</h4>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card text-center p-4 mb-3">
            <div style="width:120px;height:160px;background:linear-gradient(135deg,#667eea,#764ba2);border-radius:10px;display:flex;align-items:center;justify-content:center;margin:0 auto 15px;">
                <i class="bi bi-book text-white" style="font-size:3.5rem;"></i>
            </div>
            <h5 class="fw-bold">@Model.Title</h5>
            <p class="text-muted">@Model.Author</p>
            <span class="badge bg-secondary">@Model.Category?.Name</span>
            <div class="mt-3">
                <span class="badge @(Model.AvailableQuantity > 0 ? "bg-success" : "bg-danger") fs-6 px-3 py-2">
                    @(Model.AvailableQuantity > 0 ? $"Còn {Model.AvailableQuantity} cuốn" : "Hết sách")
                </span>
            </div>
        </div>
        <div class="d-flex flex-column gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil me-2"></i>Chỉnh sửa
            </a>
            @if (User.IsInRole("Reader") && Model.AvailableQuantity > 0)
            {
                <a asp-controller="Borrow" asp-action="Borrow" asp-route-bookId="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-bookmark-plus me-2"></i>Mượn sách này
                </a>
            }
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Thông tin chi tiết</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr><td class="fw-semibold text-muted w-40">Tên sách</td><td>@Model.Title</td></tr>
                    <tr><td class="fw-semibold text-muted">Tác giả</td><td>@Model.Author</td></tr>
                    <tr><td class="fw-semibold text-muted">Nhà xuất bản</td><td>@Model.Publisher</td></tr>
                    <tr><td class="fw-semibold text-muted">Năm xuất bản</td><td>@(Model.PublishedYear?.ToString() ?? "—")</td></tr>
                    <tr><td class="fw-semibold text-muted">ISBN</td><td>@(Model.ISBN ?? "—")</td></tr>
                    <tr><td class="fw-semibold text-muted">Danh mục</td><td><span class="badge bg-secondary">@Model.Category?.Name</span></td></tr>
                    <tr><td class="fw-semibold text-muted">Tổng số lượng</td><td>@Model.TotalQuantity</td></tr>
                    <tr><td class="fw-semibold text-muted">Số lượng còn lại</td><td>@Model.AvailableQuantity</td></tr>
                    <tr><td class="fw-semibold text-muted">Ngày thêm</td><td>@Model.CreatedAt.ToString("dd/MM/yyyy")</td></tr>
                </table>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <hr />
                    <h6 class="fw-semibold">Mô tả</h6>
                    <p class="text-muted">@Model.Description</p>
                }
            </div>
        </div>
    </div>
</div>
