@model Book
@{
    ViewData["Title"] = "Thêm sách mới";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>Thêm sách mới</h4>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="bookForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control" placeholder="Tên sách" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Danh mục</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Author" class="form-label fw-semibold"></label>
                            <input asp-for="Author" class="form-control" placeholder="Tên tác giả" />
                            <span asp-validation-for="Author" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Publisher" class="form-label fw-semibold"></label>
                            <input asp-for="Publisher" class="form-control" placeholder="Nhà xuất bản" />
                            <span asp-validation-for="Publisher" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="PublishedYear" class="form-label fw-semibold"></label>
                            <input asp-for="PublishedYear" class="form-control" type="number" min="1800" max="2099" placeholder="2023" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ISBN" class="form-label fw-semibold"></label>
                            <input asp-for="ISBN" class="form-control" placeholder="978-xxxx" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="TotalQuantity" class="form-label fw-semibold"></label>
                            <input asp-for="TotalQuantity" class="form-control" type="number" min="1" value="1" />
                            <span asp-validation-for="TotalQuantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Mô tả nội dung sách..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary px-4" onclick="confirmAdd()">
                            <i class="bi bi-plus-lg me-2"></i>Thêm sách
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận thêm sách</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">Bạn có chắc chắn muốn thêm sách này?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="document.getElementById('bookForm').submit()">
                    <i class="bi bi-check-lg me-1"></i>Có, thêm sách
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    function confirmAdd() {
        if (!document.getElementById('bookForm').checkValidity()) {
            document.getElementById('bookForm').reportValidity();
            return;
        }
        new bootstrap.Modal(document.getElementById('confirmModal')).show();
    }
    </script>
}
