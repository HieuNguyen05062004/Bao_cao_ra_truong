@model ProfileViewModel
@{
    ViewData["Title"] = "Thông tin tài khoản";
}

<div class="row">
    <div class="col-md-4">
        <div class="card text-center p-4 mb-3">
            <div class="mb-3">
                <div style="width:80px;height:80px;background:#3498db;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto;">
                    <i class="bi bi-person-fill text-white" style="font-size:2.5rem;"></i>
                </div>
            </div>
            <h5 class="fw-bold">@Model.FullName</h5>
            <p class="text-muted">@Model.Email</p>
            @foreach (var role in Model.Roles)
            {
                <span class="badge bg-primary">@(role == "Admin" ? "Quản trị viên" : role == "Staff" ? "Nhân viên" : "Bạn đọc")</span>
            }
        </div>
        <div class="card">
            <div class="list-group list-group-flush">
                <a asp-action="Profile" class="list-group-item list-group-item-action active">
                    <i class="bi bi-person me-2"></i>Thông tin cá nhân
                </a>
                <a asp-action="ChangePassword" class="list-group-item list-group-item-action">
                    <i class="bi bi-lock me-2"></i>Đổi mật khẩu
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil me-2"></i>Chỉnh sửa thông tin</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold"></label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <input asp-for="Address" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-2"></i>Lưu thay đổi
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
