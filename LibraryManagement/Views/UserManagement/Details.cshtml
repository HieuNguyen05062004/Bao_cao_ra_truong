@model LibraryManagement.Models.ApplicationUser
@{
    ViewData["Title"] = "Chi tiết tài khoản";
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <h4 class="fw-bold mb-0"><i class="bi bi-person me-2 text-primary"></i>Chi tiết tài khoản</h4>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card text-center p-4 mb-3">
            <div style="width:80px;height:80px;background:#3498db;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto;">
                <i class="bi bi-person-fill text-white" style="font-size:2.5rem;"></i>
            </div>
            <h5 class="fw-bold mt-3">@Model.FullName</h5>
            <p class="text-muted">@Model.Email</p>
            <div class="d-flex justify-content-center gap-2">
                @foreach (var role in roles)
                {
                    <span class="badge bg-primary">@(role == "Admin" ? "Quản trị viên" : role == "Staff" ? "Nhân viên" : "Bạn đọc")</span>
                }
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Hoạt động" : "Vô hiệu")</span>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><td class="fw-semibold text-muted">Họ và tên</td><td>@Model.FullName</td></tr>
                    <tr><td class="fw-semibold text-muted">Email</td><td>@Model.Email</td></tr>
                    <tr><td class="fw-semibold text-muted">Số điện thoại</td><td>@(Model.PhoneNumber ?? "—")</td></tr>
                    <tr><td class="fw-semibold text-muted">Ngày sinh</td><td>@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                    <tr><td class="fw-semibold text-muted">Địa chỉ</td><td>@(Model.Address ?? "—")</td></tr>
                    <tr><td class="fw-semibold text-muted">Ngày tạo</td><td>@Model.CreatedAt.ToString("dd/MM/yyyy")</td></tr>
                </table>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning flex-grow-1">
                <i class="bi bi-pencil me-2"></i>Chỉnh sửa
            </a>
        </div>
    </div>
</div>
