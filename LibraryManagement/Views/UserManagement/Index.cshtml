@model IList<LibraryManagement.Models.ApplicationUser>
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-people me-2 text-primary"></i>Quản lý tài khoản</h4>
        <p class="text-muted mb-0">Tổng: @Model.Count tài khoản</p>
    </div>
    <div class="d-flex gap-2">
        <div class="btn-group">
            <a asp-action="Index" class="btn btn-outline-secondary @(ViewBag.SelectedRole == null ? "active" : "")">Tất cả</a>
            <a asp-action="Index" asp-route-role="Admin" class="btn btn-outline-secondary @(ViewBag.SelectedRole == "Admin" ? "active" : "")">Admin</a>
            <a asp-action="Index" asp-route-role="Staff" class="btn btn-outline-secondary @(ViewBag.SelectedRole == "Staff" ? "active" : "")">Nhân viên</a>
            <a asp-action="Index" asp-route-role="Reader" class="btn btn-outline-secondary @(ViewBag.SelectedRole == "Reader" ? "active" : "")">Bạn đọc</a>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>Thêm tài khoản
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white py-3">
        <input type="text" id="searchInput" class="form-control" style="max-width:300px;" placeholder="Tìm kiếm tài khoản..." />
    </div>
    <div class="card-body p-0">
        <form id="deleteForm" asp-action="DeleteMultiple" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ids" id="selectedIds" />
            <div class="d-flex align-items-center px-3 py-2 border-bottom bg-light">
                <button type="button" class="btn btn-danger btn-sm me-2" id="deleteSelectedBtn" onclick="deleteSelected()" disabled>
                    <i class="bi bi-trash me-1"></i>Xóa đã chọn
                </button>
                <span class="text-muted small" id="selectedCount">Chưa chọn mục nào</span>
            </div>
            <table class="table table-hover mb-0" id="userTable">
                <thead class="table-light">
                    <tr>
                        <th width="40"><input type="checkbox" id="selectAll" onchange="toggleAll(this)" /></th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Trạng thái</th>
                        <th width="150">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td><input type="checkbox" class="row-check" value="@user.Id" onchange="updateSelection()" /></td>
                            <td>
                                <div class="fw-semibold">@user.FullName</div>
                                <div class="text-muted small">@user.CreatedAt.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>@user.Email</td>
                            <td>@(user.PhoneNumber ?? "—")</td>
                            <td>
                                <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                                    @(user.IsActive ? "Hoạt động" : "Vô hiệu")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa"
                                            onclick="confirmDelete('@user.Id', '@(user.FullName.Replace("'", "\\'"))' )">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    </div>
</div>

<form id="deleteSingleForm" asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteUserId" />
</form>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">Xóa tài khoản <strong id="deleteUserName"></strong>?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="document.getElementById('deleteSingleForm').submit()">Xóa</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteMultiModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body" id="deleteMultiMsg"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="document.getElementById('deleteForm').submit()">Xóa</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function toggleAll(cb) { document.querySelectorAll('.row-check').forEach(c => c.checked = cb.checked); updateSelection(); }
function updateSelection() {
    const cnt = document.querySelectorAll('.row-check:checked').length;
    document.getElementById('deleteSelectedBtn').disabled = cnt === 0;
    document.getElementById('selectedCount').textContent = cnt > 0 ? `Đã chọn ${cnt} mục` : 'Chưa chọn mục nào';
}
function deleteSelected() {
    const ids = Array.from(document.querySelectorAll('.row-check:checked')).map(c => c.value);
    document.getElementById('deleteMultiMsg').textContent = `Xóa ${ids.length} tài khoản đã chọn?`;
    document.getElementById('selectedIds').value = ids.join(',');
    new bootstrap.Modal(document.getElementById('deleteMultiModal')).show();
}
function confirmDelete(id, name) {
    document.getElementById('deleteUserId').value = id;
    document.getElementById('deleteUserName').textContent = name;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
document.getElementById('searchInput').addEventListener('input', function() {
    const val = this.value.toLowerCase();
    document.querySelectorAll('#userTable tbody tr').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
    });
});
</script>
}
