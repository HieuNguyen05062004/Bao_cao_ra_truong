@model SearchViewModel
@{
    ViewData["Title"] = "Tìm kiếm AI";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-robot me-2 text-primary"></i>Tìm kiếm thông minh (AI)</h4>
        <p class="text-muted mb-0 small">Tìm kiếm bằng ngôn ngữ tự nhiên</p>
    </div>
</div>

<!-- Search bar -->
<div class="card mb-4">
    <div class="card-body p-4">
        <form asp-action="AiSearch" method="post">
            @Html.AntiForgeryToken()
            <div class="input-group input-group-lg mb-3">
                <span class="input-group-text bg-primary text-white"><i class="bi bi-robot"></i></span>
                <input type="text" name="query" class="form-control fs-5" value="@Model.Query"
                       placeholder="VD: sách Java cho người mới học lập trình..." />
                <button type="submit" class="btn btn-primary px-4 fw-bold">Tìm kiếm</button>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <span class="text-muted small">Thử ngay:</span>
                <button type="submit" name="query" value="sách lập trình Java cho người mới" class="btn btn-sm btn-outline-secondary">sách Java người mới</button>
                <button type="submit" name="query" value="tiểu thuyết văn học kinh điển" class="btn btn-sm btn-outline-secondary">văn học kinh điển</button>
                <button type="submit" name="query" value="sách kinh doanh quản trị" class="btn btn-sm btn-outline-secondary">kinh doanh quản trị</button>
                <button type="submit" name="query" value="Python machine learning" class="btn btn-sm btn-outline-secondary">Python ML</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Query))
{
    <!-- AI Interpretation -->
    @if (!string.IsNullOrEmpty(Model.AiInterpretation))
    {
        <div class="alert alert-info d-flex align-items-center mb-4">
            <i class="bi bi-robot me-3 fs-4 text-info"></i>
            <div>
                <strong>AI hiểu:</strong> @Model.AiInterpretation
                @if (Model.AiSuggestions.Any())
                {
                    <div class="mt-1 small">
                        <strong>Gợi ý:</strong> @string.Join(" | ", Model.AiSuggestions)
                    </div>
                }
            </div>
        </div>
    }

    <!-- Results -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Kết quả cho: <span class="text-primary">"@Model.Query"</span></h5>
        <span class="text-muted">@Model.TotalResults kết quả</span>
    </div>

    @if (!Model.Results.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-search text-muted" style="font-size:4rem;"></i>
                <h5 class="mt-3 text-muted">Không tìm thấy kết quả phù hợp</h5>
                <p class="text-muted">Thử tìm kiếm với từ khóa khác hoặc sử dụng tìm kiếm cơ bản</p>
                <a asp-action="Index" class="btn btn-primary mt-2">
                    <i class="bi bi-search me-2"></i>Tìm kiếm cơ bản
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var book in Model.Results)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card book-card h-100">
                        <div class="card-body">
                            <div class="d-flex gap-3">
                                <div style="width:60px;height:80px;background:linear-gradient(135deg,#667eea,#764ba2);border-radius:8px;flex-shrink:0;display:flex;align-items:center;justify-content:center;">
                                    <i class="bi bi-book text-white fs-3"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold mb-1">@book.Title</h6>
                                    <div class="text-muted small">@book.Author</div>
                                    <div class="mt-1"><span class="badge bg-secondary small">@book.Category?.Name</span></div>
                                    <div class="mt-1 d-flex gap-1 flex-wrap">
                                        <span class="badge @(book.AvailableQuantity > 0 ? "bg-success" : "bg-danger") small">
                                            @(book.AvailableQuantity > 0 ? $"Còn {book.AvailableQuantity}" : "Hết sách")
                                        </span>
                                    </div>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(book.Description))
                            {
                                <p class="text-muted small mt-2 mb-0 text-truncate" title="@book.Description">@book.Description</p>
                            }
                            @if (User.IsInRole("Reader") && book.AvailableQuantity > 0)
                            {
                                <div class="mt-3">
                                    <a asp-controller="Borrow" asp-action="Borrow" asp-route-bookId="@book.Id"
                                       class="btn btn-primary btn-sm w-100">
                                        <i class="bi bi-bookmark-plus me-1"></i>Mượn sách
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
