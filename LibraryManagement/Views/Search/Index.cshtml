@model SearchViewModel
@{
    ViewData["Title"] = "Tìm kiếm sách";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1"><i class="bi bi-search me-2 text-primary"></i>Tìm kiếm sách</h4>
    <p class="text-muted mb-0">Tìm kiếm theo tên sách, tác giả, thể loại</p>
</div>

<!-- Search Forms -->
<div class="card mb-4">
    <div class="card-body p-4">
        <ul class="nav nav-tabs mb-4" id="searchTabs">
            <li class="nav-item">
                <a class="nav-link @(Model.SearchType != "ai" ? "active" : "")" data-bs-toggle="tab" href="#basicSearch">
                    <i class="bi bi-search me-2"></i>Tìm kiếm cơ bản
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.SearchType == "ai" ? "active" : "")" data-bs-toggle="tab" href="#aiSearch">
                    <i class="bi bi-robot me-2"></i>Tìm kiếm AI
                </a>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade @(Model.SearchType != "ai" ? "show active" : "")" id="basicSearch">
                <form asp-action="Basic" method="get">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Tên sách</label>
                            <input type="text" name="title" class="form-control" value="@Context.Request.Query["title"]" placeholder="Nhập tên sách..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Tác giả</label>
                            <input type="text" name="author" class="form-control" value="@Context.Request.Query["author"]" placeholder="Nhập tên tác giả..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Thể loại</label>
                            <input type="text" name="category" class="form-control" value="@Context.Request.Query["category"]" placeholder="Nhập thể loại..." />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-search me-2"></i>Tìm kiếm
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Xóa bộ lọc</a>
                    </div>
                </form>
            </div>

            <div class="tab-pane fade @(Model.SearchType == "ai" ? "show active" : "")" id="aiSearch">
                <form asp-action="Ai" method="get">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-robot me-2 text-primary"></i>Nhập truy vấn tìm kiếm
                        </label>
                        <div class="input-group input-group-lg">
                            <input type="text" name="query" class="form-control" value="@Context.Request.Query["query"]"
                                   placeholder="VD: sách Java cho người mới, tiểu thuyết kinh điển..." />
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-send me-1"></i>Tìm kiếm
                            </button>
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="text-muted small">Thử ngay:</span>
                        <a href="#" class="badge bg-light text-dark text-decoration-none" onclick="setQuery('sách lập trình Java cho người mới')">sách lập trình Java cho người mới</a>
                        <a href="#" class="badge bg-light text-dark text-decoration-none" onclick="setQuery('tiểu thuyết văn học Việt Nam')">tiểu thuyết văn học Việt Nam</a>
                        <a href="#" class="badge bg-light text-dark text-decoration-none" onclick="setQuery('sách kinh tế kinh doanh')">sách kinh tế kinh doanh</a>
                        <a href="#" class="badge bg-light text-dark text-decoration-none" onclick="setQuery('lập trình Python cơ bản')">lập trình Python cơ bản</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Results -->
@if (Model.Results.Any() || !string.IsNullOrEmpty(Model.Query))
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">
            Kết quả tìm kiếm
            @if (!string.IsNullOrEmpty(Model.Query))
            {
                <span class="text-primary">"@Model.Query"</span>
            }
        </h5>
        <span class="text-muted">@Model.TotalResults kết quả</span>
    </div>

    @if (!Model.Results.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-search text-muted" style="font-size:4rem;"></i>
                <h5 class="mt-3 text-muted">Không tìm thấy sách phù hợp</h5>
                <p class="text-muted">Thử tìm kiếm với từ khóa khác</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var book in Model.Results)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card book-card h-100">
                        <div class="card-body">
                            <div class="d-flex gap-3">
                                <div style="width:60px;height:80px;background:linear-gradient(135deg,#667eea,#764ba2);border-radius:8px;flex-shrink:0;display:flex;align-items:center;justify-content:center;">
                                    <i class="bi bi-book text-white fs-3"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold mb-1">@book.Title</h6>
                                    <div class="text-muted small">@book.Author</div>
                                    <div class="mt-1"><span class="badge bg-secondary small">@book.Category?.Name</span></div>
                                    <div class="mt-1">
                                        <span class="badge @(book.AvailableQuantity > 0 ? "bg-success" : "bg-danger") small">
                                            @(book.AvailableQuantity > 0 ? $"Còn {book.AvailableQuantity}" : "Hết sách")
                                        </span>
                                    </div>
                                </div>
                            </div>
                            @if (User.IsInRole("Reader") && book.AvailableQuantity > 0)
                            {
                                <div class="mt-3">
                                    <a asp-controller="Borrow" asp-action="Borrow" asp-route-bookId="@book.Id"
                                       class="btn btn-primary btn-sm w-100">
                                        <i class="bi bi-bookmark-plus me-1"></i>Mượn sách
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@section Scripts {
<script>
function setQuery(q) {
    document.querySelector('#aiSearch input[name="query"]').value = q;
    document.querySelector('#aiSearch button[type="submit"]').click();
    return false;
}
</script>
}
