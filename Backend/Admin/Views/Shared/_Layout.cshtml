<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị viên</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Admin.styles.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #3b7ef8;
            --bg-light: #f5f7fb;
            --text-muted: #6b7280;
            --border-color: #e5e7ef;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            background: var(--bg-light);
        }

        body {
            display: flex;
            flex-direction: column;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        main {
            flex: 1;
        }

        /* Navbar */
        .navbar {
            background: #fff !important;
            border-bottom: 1px solid var(--border-color) !important;
            box-shadow: 0 1px 4px rgba(0,0,0,.06);
            padding: 12px 0;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.1rem;
            color: var(--text-muted) !important;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .navbar-brand i {
            color: var(--primary-color);
            font-size: 1.3rem;
        }

        .nav-link {
            color: var(--text-muted) !important;
            font-size: 0.9rem;
            transition: color 0.2s;
            margin: 0 8px;
        }

        .nav-link:hover {
            color: var(--primary-color) !important;
        }

        /* User Profile Dropdown */
        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 12px;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .user-profile:hover {
            background: var(--bg-light);
        }

        .user-profile img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--primary-color);
        }

        .user-profile span {
            font-weight: 500;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .dropdown-menu {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 8px;
            box-shadow: 0 8px 24px rgba(0,0,0,.10);
            margin-top: 8px;
        }

        .dropdown-item {
            color: var(--text-muted);
            border-radius: 8px;
            font-size: 0.88rem;
            padding: 8px 14px;
            transition: all 0.15s;
        }

        .dropdown-item:hover {
            background: var(--bg-light);
            color: var(--primary-color);
        }

        .dropdown-item.text-danger:hover {
            background: #fee;
            color: #dc3545;
        }

        /* Container responsive */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }

        /* Footer */
        footer {
            background: #fff;
            border-top: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 20px 0;
            font-size: 0.85rem;
            margin-top: auto;
            text-align: center;
        }

        footer a {
            color: var(--text-muted);
            text-decoration: none;
        }

        footer a:hover {
            color: var(--primary-color);
        }

        /* Mobile responsive */
        @@media (max-width: 768px) {
            .navbar-brand {
                font-size: 1rem;
            }

            .nav-link {
                font-size: 0.85rem;
                margin: 0 4px;
            }

            .user-profile {
                padding: 0 8px;
                gap: 8px;
            }

            .user-profile span {
                display: none;
            }

            .user-profile img {
                width: 28px;
                height: 28px;
            }

            .container {
                padding: 0 10px;
            }

            main {
                padding: 10px 0 !important;
            }
        }

        @@media (max-width: 576px) {
            .navbar {
                padding: 10px 0;
            }

            .navbar-brand {
                font-size: 0.95rem;
            }

            .navbar-toggler {
                border: none;
                padding: 0.2rem 0.5rem;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid">
                <!-- Brand -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-lock-open"></i>
                    Quản trị
                </a>

                <!-- Toggler for mobile -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarNav" aria-controls="navbarNav" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Nav items -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2 gap-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i> Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Book" asp-action="Index">
                                <i class="fas fa-book me-1"></i> Sách
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Category" asp-action="Index">
                                <i class="fas fa-tags me-1"></i> Thể loại
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reader" asp-action="Index">
                                <i class="fas fa-users me-1"></i> Bạn đọc
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Staff" asp-action="Index">
                                <i class="fas fa-id-badge me-1"></i> Nhân viên
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Borrow" asp-action="Index">
                                <i class="fas fa-receipt me-1"></i> Mượn trả
                            </a>
                        </li>

                        <!-- User Profile Dropdown -->
                        <li class="nav-item dropdown ms-lg-3 ms-2">
                            <a class="dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" 
                               role="button" data-bs-toggle="dropdown" style="text-decoration: none;">
                                <div class="user-profile">
                                    @{
                                        var fullName = Context.Session.GetString("FullName") ?? "Quản trị viên";
                                        var avatarUrl = Context.Session.GetString("AvatarUrl");
                                    }

                                    @if (!string.IsNullOrEmpty(avatarUrl))
                                    {
                                        <img src="@avatarUrl" alt="Avatar" />
                                    }
                                    else
                                    {
                                        <div style="width:32px;height:32px;border-radius:50%;background:var(--primary-color);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600;">
                                            @fullName.Substring(0, 1).ToUpper()
                                        </div>
                                    }
                                    <span class="d-none d-md-inline">@fullName</span>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <i class="fas fa-user-circle me-2"></i> Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline w-100">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger w-100 text-start">
                                            <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <footer>
        <div class="container">
            &copy; 2026 - Hệ thống quản lý thư viện
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Auto-dismiss alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 5000);
            });
        });
    </script>
</body>
</html>
