@*
    Partial View: _CategoryChips.cshtml
    Đặt tại: Admin/Views/Shared/_CategoryChips.cshtml

    Cách dùng trong Create.cshtml / Edit.cshtml:
        @await Html.PartialAsync("_CategoryChips", new Admin.ViewModels.CategoryChipsViewModel
        {
            Categories  = Model.Categories,
            SelectedIds = Model.CategoryIds,
            InputName   = "CategoryIds"
        })

    Cơ chế hoạt động:
    - Mỗi chip được chọn → JavaScript thêm 1 hidden input tên "CategoryIds" vào form
    - ASP.NET Core model binding tự nhận List<int> CategoryIds từ nhiều input cùng tên
    - Bỏ chọn → xóa hidden input tương ứng
*@

@model Admin.ViewModels.CategoryChipsViewModel

<div class="category-chips-wrapper mb-3">
    <label class="form-label fw-semibold">
        Thể loại
        <span class="text-muted fw-normal small">(có thể chọn nhiều)</span>
    </label>

    @* Container render chips *@
    <div class="chips-container" id="chipsContainer" role="group" aria-label="Chọn thể loại sách">
        @if (!Model.Categories.Any())
        {
            <span class="text-muted small fst-italic">
                Chưa có danh mục nào.
            </span>
        }
        else
        {
            @foreach (var cat in Model.Categories)
            {
                var isSelected = Model.SelectedIds.Contains(cat.CategoryId);
                <button type="button"
                        class="chip @(isSelected ? "chip--selected" : "")"
                        data-id="@cat.CategoryId"
                        aria-pressed="@(isSelected ? "true" : "false")">
                    @if (isSelected)
                    {
                        <span class="chip-check">✓</span>
                    }
                    @cat.CategoryName
                </button>
            }
        }
    </div>

    @*
        Hidden inputs: mỗi danh mục đang được chọn = 1 hidden input.
        JavaScript thêm/xóa các input này khi click chip.
        Model binding của ASP.NET Core đọc tất cả input cùng tên → List<int>.
    *@
    <div id="hiddenInputsContainer">
        @foreach (var id in Model.SelectedIds)
        {
            <input type="hidden" name="@Model.InputName" value="@id" />
        }
    </div>

    <span class="text-danger small" id="categoryValidationMsg"></span>
</div>

<style>
    .chips-container {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 4px 0 8px;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 14px;
        border-radius: 999px;
        border: 1.5px solid #d0d5dd;
        background: #ffffff;
        color: #344054;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        user-select: none;
        transition: border-color 0.15s, background 0.15s,
                    color 0.15s, box-shadow 0.15s, transform 0.1s;
    }

    .chip:hover {
        border-color: #0d6efd;
        color: #0d6efd;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
    }

    .chip--selected {
        background: #0d6efd;
        border-color: #0d6efd;
        color: #ffffff;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.18);
    }

    .chip--selected:hover {
        background: #0b5ed7;
        border-color: #0b5ed7;
        transform: scale(0.97);
    }

    /* Animation khi chip được chọn */
    .chip--pop {
        animation: chipPop 0.18s ease;
    }

    @@keyframes chipPop {
        0%   { transform: scale(1); }
        50%  { transform: scale(1.08); }
        100% { transform: scale(1); }
    }

    .chip-check {
        font-size: 0.75rem;
        font-weight: 700;
    }
</style>

<script>
(function () {
    const inputName      = '@Model.InputName';
    const container      = document.getElementById('hiddenInputsContainer');
    const chipsContainer = document.getElementById('chipsContainer');
    const validationMsg  = document.getElementById('categoryValidationMsg');

    // Lấy Set (tập hợp) các ID đang chọn từ hidden inputs đã render sẵn
    const selectedIds = new Set(
        Array.from(container.querySelectorAll('input[type=hidden]'))
             .map(i => i.value)
    );

    document.querySelectorAll('.chip').forEach(function (chip) {
        chip.addEventListener('click', function () {
            const id = this.dataset.id;

            if (selectedIds.has(id)) {
                // Bỏ chọn: xóa class, xóa hidden input, xóa khỏi Set
                this.classList.remove('chip--selected');
                this.setAttribute('aria-pressed', 'false');
                this.querySelector('.chip-check')?.remove();
                selectedIds.delete(id);

                const input = container.querySelector(`input[value="${id}"]`);
                if (input) input.remove();
            } else {
                // Chọn: thêm class, thêm hidden input, thêm vào Set
                this.classList.add('chip--selected', 'chip--pop');
                this.setAttribute('aria-pressed', 'true');

                // Thêm dấu check vào đầu nội dung chip
                if (!this.querySelector('.chip-check')) {
                    const check = document.createElement('span');
                    check.className = 'chip-check';
                    check.textContent = '✓';
                    this.prepend(check);
                }

                selectedIds.add(id);

                const input = document.createElement('input');
                input.type  = 'hidden';
                input.name  = inputName;
                input.value = id;
                container.appendChild(input);

                // Xóa class animation sau khi xong
                this.addEventListener('animationend', () => {
                    this.classList.remove('chip--pop');
                }, { once: true });
            }

            // Xóa thông báo lỗi khi đã có ít nhất 1 danh mục được chọn
            if (selectedIds.size > 0) {
                chipsContainer.classList.remove('is-invalid');
                validationMsg.textContent = '';
            }
        });
    });
})();
</script>
