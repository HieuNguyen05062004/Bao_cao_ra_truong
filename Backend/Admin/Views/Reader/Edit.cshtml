@model Admin.ViewModels.ReaderViewModel
@{
    ViewData["Title"] = "Chỉnh sửa bạn đọc";
}

<h4>✏️ Chỉnh sửa bạn đọc: <strong>@Model.ReaderId</strong></h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.ReaderId"
              method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Mã bạn đọc</label>
                <input value="@Model.ReaderId" class="form-control" readonly disabled />
                <input type="hidden" name="ReaderId" value="@Model.ReaderId" />
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DoB" class="form-label fw-semibold"></label>
                <input asp-for="DoB" type="date" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Gender" class="form-label fw-semibold"></label>
                <select asp-for="Gender" class="form-select">
                    <option value="">-- Chọn giới tính --</option>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label fw-semibold"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label fw-semibold"></label>
                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Ảnh đại diện hiện tại</label><br />
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" width="80" height="80"
                         class="rounded-circle mb-2" style="object-fit:cover" />
                }
                else
                {
                    <span class="text-muted">Chưa có ảnh</span>
                }
                <input type="hidden" asp-for="AvatarUrl" />
            </div>

            <div class="mb-3">
                <label asp-for="AvatarFile" class="form-label fw-semibold">Tải ảnh mới</label>
                <input asp-for="AvatarFile" type="file" class="form-control" accept="image/*" />
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
