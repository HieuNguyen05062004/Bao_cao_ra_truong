@model IEnumerable<Admin.ViewModels.ReaderViewModel>
@{
    ViewData["Title"] = "Quản lý bạn đọc";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">🧑‍🤝‍🧑 Danh sách bạn đọc</h4>
    <a asp-action="Create" class="btn btn-primary">+ Thêm bạn đọc</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Tìm kiếm *@
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width:420px">
        <input type="text" name="keyword" value="@ViewBag.Keyword"
               class="form-control" placeholder="Tìm theo mã, tên, email, SĐT..." />
        <button class="btn btn-outline-secondary" type="submit">Tìm</button>
        @if (!string.IsNullOrEmpty(ViewBag.Keyword as string))
        {
            <a asp-action="Index" class="btn btn-outline-danger">✕</a>
        }
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Ảnh</th>
                <th>Mã bạn đọc</th>
                <th>Họ tên</th>
                <th>Giới tính</th>
                <th>SĐT</th>
                <th>Email</th>
                <th class="text-center">Đang mượn</th>
                <th class="text-center">Quá hạn</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(r.AvatarUrl))
                        {
                            <img src="@r.AvatarUrl" class="rounded-circle"
                                 width="40" height="40" style="object-fit:cover" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary d-inline-flex
                                align-items-center justify-content-center"
                                 style="width:40px;height:40px;color:white;font-weight:bold">
                                @r.FullName.Substring(0, 1).ToUpper()
                            </div>
                        }
                    </td>
                    <td>@r.ReaderId</td>
                    <td>@r.FullName</td>
                    <td>@(r.Gender ?? "—")</td>
                    <td>@(r.Phone ?? "—")</td>
                    <td>@(r.Email ?? "—")</td>
                    <td class="text-center">
                        @if (r.BorrowingCount > 0)
                        {
                            <span class="badge bg-primary">@r.BorrowingCount</span>
                        }
                        else
                        {
                            <span class="text-muted">0</span>
                        }
                    </td>
                    <td class="text-center">
                        @if (r.OverdueCount > 0)
                        {
                            <span class="badge bg-danger">@r.OverdueCount</span>
                        }
                        else
                        {
                            <span class="text-muted">0</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@r.ReaderId"
                           class="btn btn-sm btn-info text-white">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@r.ReaderId"
                           class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@r.ReaderId"
                           class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">
                        Không tìm thấy bạn đọc nào.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
