@model IEnumerable<Admin.ViewModels.StaffViewModel>
@{
    ViewData["Title"] = "Quản lý tài khoản nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">👤 Danh sách tài khoản nhân viên</h4>
    <a asp-action="Create" class="btn btn-primary">+ Thêm tài khoản</a>
</div>

@* Thông báo thành công / lỗi *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Tìm kiếm *@
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width:400px">
        <input type="text" name="keyword" value="@ViewBag.Keyword"
               class="form-control" placeholder="Tìm theo tên, username, email..." />
        <button class="btn btn-outline-secondary" type="submit">Tìm</button>
        @if (!string.IsNullOrEmpty(ViewBag.Keyword as string))
        {
            <a asp-action="Index" class="btn btn-outline-danger">✕</a>
        }
    </div>
</form>

@* Bảng danh sách *@
<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Ảnh</th>
                <th>Username</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Quyền hạn</th>
                <th>Ngày tạo</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var staff in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(staff.AvatarUrl))
                        {
                            <img src="@staff.AvatarUrl" alt="avatar"
                                 class="rounded-circle" width="40" height="40"
                                 style="object-fit:cover" />
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>@staff.Username</td>
                    <td>@staff.FullName</td>
                    <td>@staff.Email</td>
                    <td>
                        @if (staff.Role == "Admin")
                        {
                            <span class="badge bg-danger">Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Staff</span>
                        }
                    </td>
                    <td>@staff.CreatedAt?.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-username="@staff.Username"
                           class="btn btn-sm btn-info text-white">Chi tiết</a>

                        <a asp-action="Edit" asp-route-username="@staff.Username"
                           class="btn btn-sm btn-warning">Sửa</a>

                        <form asp-action="Delete" asp-route-username="@staff.Username"
                              method="post" class="d-inline"
                              onsubmit="return confirm('Xác nhận xóa tài khoản @staff.Username?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">Không tìm thấy tài khoản nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
