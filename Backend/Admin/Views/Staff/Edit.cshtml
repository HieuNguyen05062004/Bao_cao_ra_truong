@model Admin.ViewModels.StaffViewModel
@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
}

<h4>✏️ Chỉnh sửa tài khoản: <strong>@Model.Username</strong></h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-username="@Model.Username"
              method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            @* Username chỉ đọc *@
            <div class="mb-3">
                <label class="form-label fw-semibold">Tên đăng nhập</label>
                <input value="@Model.Username" class="form-control" readonly disabled />
                <input type="hidden" name="Username" value="@Model.Username" />
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label fw-semibold"></label>
                <select asp-for="Role" class="form-select">
                    <option value="Staff">Staff - Nhân viên</option>
                    <option value="Admin">Admin - Quản trị viên</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold">
                    Mật khẩu mới <span class="text-muted fw-normal">(để trống nếu không đổi)</span>
                </label>
                <div class="input-group">
                    <input asp-for="Password" id="editPassword"
                           class="form-control"
                           placeholder="Nhập mật khẩu mới nếu muốn thay đổi" />
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="togglePassword('editPassword', this)">
                        👁
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Ảnh đại diện hiện tại</label><br />
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" width="80" height="80"
                         class="rounded-circle mb-2" style="object-fit:cover" />
                }
                else
                {
                    <span class="text-muted">Chưa có ảnh</span>
                }
                <input type="hidden" asp-for="AvatarUrl" />
            </div>

            <div class="mb-3">
                <label asp-for="AvatarFile" class="form-label fw-semibold">Tải ảnh mới</label>
                <input asp-for="AvatarFile" type="file" class="form-control" accept="image/*" />
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = '🙈';
            } else {
                input.type = 'password';
                btn.textContent = '👁';
            }
        }
    </script>
}
