@model IEnumerable<Core.Shared.Entities.BorrowTicket>
@{
    ViewData["Title"] = "Quản Lý Phiếu Mượn";
    var selectedStatus = ViewBag.SelectedStatus as string ?? "";
    var keyword = ViewBag.Keyword as string ?? "";
    var statusList = ViewBag.StatusList as string[] ?? Array.Empty<string>();
}

@* ── Helper: màu badge theo trạng thái ── *@
@functions {
    static string BadgeClass(string? status) => status switch
    {
        "Chờ duyệt" => "bg-warning text-dark",
        "Đã duyệt" => "bg-info text-dark",
        "Đang mượn" => "bg-primary",
        "Đã trả" => "bg-success",
        "Bị từ chối" => "bg-danger",
        _ => "bg-secondary"
    };

    static string RowClass(string? status) => status switch
    {
        "Chờ duyệt" => "table-warning",
        "Đã duyệt" => "table-info",
        "Đang mượn" => "table-primary",
        "Bị từ chối" => "table-danger",
        _ => ""
    };
}

<div class="container-fluid py-4">

    @* ── Tiêu đề ── *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-journal-bookmark me-2 text-primary"></i>Quản Lý Phiếu Mượn
            </h2>
            <p class="text-muted mb-0">Duyệt, theo dõi và quản lý toàn bộ phiếu mượn sách</p>
        </div>
    </div>

    @* ── Thông báo ── *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── Thống kê nhanh ── *@
    <div class="row g-3 mb-4">
        @{
            var stats = new[]
            {
                ("Chờ duyệt",  (int)ViewBag.CountPending,   "bi-hourglass-split",  "warning",  "Chờ duyệt"),
                ("Đã duyệt",   (int)ViewBag.CountApproved,  "bi-check-circle",     "info",     "Đã duyệt"),
                ("Đang mượn",  (int)ViewBag.CountBorrowing, "bi-book-half",        "primary",  "Đang mượn"),
                ("Đã trả",     (int)ViewBag.CountReturned,  "bi-archive",          "success",  "Đã trả"),
                ("Bị từ chối", (int)ViewBag.CountRejected,  "bi-x-circle",         "danger",   "Bị từ chối"),
            };
        }
        @foreach (var (label, count, icon, color, filterVal) in stats)
        {
            <div class="col-6 col-md-4 col-lg">
                <a href="@Url.Action("Index", new { status = filterVal })"
                       class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100
                        @(selectedStatus == filterVal ? $"border-{color} border-2" : "")">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-@color bg-opacity-10 p-2">
                                    <i class="bi @icon text-@color fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold fs-4 lh-1">@count</div>
                                    <small class="text-muted">@label</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
        @* Tất cả *@
        <div class="col-6 col-md-4 col-lg">
            <a href="@Url.Action("Index")" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100
                    @(selectedStatus == "" ? "border-dark border-2" : "")">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-secondary bg-opacity-10 p-2">
                                <i class="bi bi-list-ul text-secondary fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold fs-4 lh-1">
                                    @((int)ViewBag.CountPending + (int)ViewBag.CountApproved +
                                      (int)ViewBag.CountBorrowing + (int)ViewBag.CountReturned +
                                      (int)ViewBag.CountRejected)
                                </div>
                                <small class="text-muted">Tất cả</small>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    @* ── Tìm kiếm + lọc trạng thái ── *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="keyword" value="@keyword"
                               class="form-control"
                               placeholder="Tên bạn đọc, mã phiếu, tên sách…" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="">-- Tất cả --</option>
                        @foreach (var s in statusList)
                        {
                            <option value="@s" selected="@(selectedStatus == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Xóa lọc
                    </a>
                </div>
            </form>
        </div>
    </div>

    @* ── Bảng dữ liệu ── *@
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    <span>Không có phiếu mượn nào.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mã phiếu</th>
                                <th>Bạn đọc</th>
                                <th>Sách mượn</th>
                                <th>Ngày mượn</th>
                                <th>Hạn trả</th>
                                <th>Trạng thái</th>
                                <th class="text-center pe-3">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in Model)
                            {
                                var isOverdue = ticket.DueDate.HasValue
                                               && ticket.DueDate < DateTime.Now
                                               && ticket.Status != "Đã trả"
                                               && ticket.Status != "Bị từ chối";
                                <tr class="@RowClass(ticket.Status)">
                                    <td class="ps-3 fw-bold">#@ticket.TicketId</td>
                                    <td>
                                        <div class="fw-semibold">@(ticket.Reader?.FullName ?? "—")</div>
                                        <small class="text-muted">@ticket.ReaderId</small>
                                    </td>
                                    <td>
                                        @foreach (var book in ticket.Books.Take(2))
                                        {
                                            <div class="text-truncate" style="max-width:200px"
                                                 title="@book.Title">
                                                <i class="bi bi-book me-1 text-muted"></i>@book.Title
                                            </div>
                                        }
                                        @if (ticket.Books.Count > 2)
                                        {
                                            <small class="text-muted">+@(ticket.Books.Count - 2) cuốn khác</small>
                                        }
                                    </td>
                                    <td>@ticket.BorrowDate?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                            @ticket.DueDate?.ToString("dd/MM/yyyy")
                                            @if (isOverdue)
                                            {
                                                <i class="bi bi-exclamation-triangle-fill ms-1"
                                                   title="Quá hạn"></i>
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @BadgeClass(ticket.Status)">
                                            @ticket.Status
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <a asp-action="Details" asp-route-id="@ticket.TicketId"
                                               class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
