@model Core.Shared.Entities.BorrowTicket
@{
    ViewData["Title"] = $"Phiếu Mượn #{Model.TicketId}";
    var isOverdue = Model.DueDate.HasValue
                   && Model.DueDate < DateTime.Now
                   && Model.Status != "Đã trả"
                   && Model.Status != "Bị từ chối";
}

@functions {
    static (string bg, string text, string icon) StatusStyle(string? status) => status switch
    {
        "Chờ duyệt" => ("warning", "dark", "bi-hourglass-split"),
        "Đã duyệt" => ("info", "dark", "bi-check-circle"),
        "Đang mượn" => ("primary", "white", "bi-book-half"),
        "Đã trả" => ("success", "white", "bi-archive"),
        "Bị từ chối" => ("danger", "white", "bi-x-circle"),
        _ => ("secondary", "white", "bi-question-circle")
    };
}

@{
    var (bgColor, txtColor, statusIcon) = StatusStyle(Model.Status);
}

<div class="container-fluid py-4" style="max-width:960px">

    @* ── Breadcrumb ── *@
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index">Phiếu Mượn</a>
            </li>
            <li class="breadcrumb-item active">Phiếu #@Model.TicketId</li>
        </ol>
    </nav>

    @* ── Thông báo ── *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── Header phiếu ── *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <h3 class="fw-bold mb-1">
                        <i class="bi bi-journal-bookmark me-2 text-primary"></i>
                        Phiếu Mượn <span class="text-primary">#@Model.TicketId</span>
                    </h3>
                    <span class="badge bg-@bgColor text-@txtColor fs-6 px-3 py-2">
                        <i class="bi @statusIcon me-1"></i>@Model.Status
                    </span>
                    @if (isOverdue)
                    {
                        <span class="badge bg-danger ms-2 fs-6 px-3 py-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Quá hạn
                        </span>
                    }
                </div>

                @* ── Nút hành động theo trạng thái ── *@
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.Status == "Chờ duyệt")
                    {
                        @* Duyệt phiếu *@
                        <form asp-action="Approve" asp-route-id="@Model.TicketId" method="post"
                              onsubmit="return confirm('Duyệt phiếu mượn này?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg me-1"></i>Duyệt phiếu
                            </button>
                        </form>
                        @* Từ chối *@
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                data-bs-target="#modalReject">
                            <i class="bi bi-x-lg me-1"></i>Từ chối
                        </button>
                    }
                    else if (Model.Status == "Đã duyệt")
                    {
                        @* Xác nhận giao sách *@
                        <form asp-action="ConfirmBorrowing" asp-route-id="@Model.TicketId" method="post"
                              onsubmit="return confirm('Xác nhận đã giao sách cho bạn đọc?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-box-arrow-right me-1"></i>Xác nhận giao sách
                            </button>
                        </form>
                        @* Vẫn cho phép trả sách từ trạng thái Đã duyệt *@
                        <form asp-action="ReturnBooks" asp-route-id="@Model.TicketId" method="post"
                              onsubmit="return confirm('Xác nhận bạn đọc đã trả sách?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-success">
                                <i class="bi bi-arrow-return-left me-1"></i>Trả sách
                            </button>
                        </form>
                    }
                    else if (Model.Status == "Đang mượn")
                    {
                        @* Trả sách *@
                        <form asp-action="ReturnBooks" asp-route-id="@Model.TicketId" method="post"
                              onsubmit="return confirm('Xác nhận bạn đọc đã trả sách?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-arrow-return-left me-1"></i>Xác nhận trả sách
                            </button>
                        </form>
                    }

                    @* Nút xóa — chỉ hiện với phiếu đã trả / bị từ chối *@
                    @if (Model.Status == "Đã trả" || Model.Status == "Bị từ chối")
                    {
                        <form asp-action="Delete" asp-route-id="@Model.TicketId" method="post"
                              onsubmit="return confirm('Xóa phiếu mượn này? Hành động không thể hoàn tác.')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>Xóa phiếu
                            </button>
                        </form>
                    }

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        @* ── Thông tin phiếu ── *@
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent fw-bold border-bottom">
                    <i class="bi bi-info-circle me-2 text-primary"></i>Thông Tin Phiếu
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">Mã phiếu</dt>
                        <dd class="col-sm-7 fw-bold">#@Model.TicketId</dd>

                        <dt class="col-sm-5 text-muted">Ngày mượn</dt>
                        <dd class="col-sm-7">@Model.BorrowDate?.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-5 text-muted">Hạn trả</dt>
                        <dd class="col-sm-7">
                            <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                @Model.DueDate?.ToString("dd/MM/yyyy")
                            </span>
                        </dd>

                        <dt class="col-sm-5 text-muted">Ngày trả thực tế</dt>
                        <dd class="col-sm-7">
                            @(Model.ReturnDate.HasValue
                                ? Model.ReturnDate.Value.ToString("dd/MM/yyyy HH:mm")
                                : "—")
                        </dd>

                        <dt class="col-sm-5 text-muted">Nhân viên xử lý</dt>
                        <dd class="col-sm-7">@(Model.StaffUsername ?? "—")</dd>

                        <dt class="col-sm-5 text-muted">Trạng thái</dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-@bgColor text-@txtColor">@Model.Status</span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        @* ── Thông tin bạn đọc ── *@
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent fw-bold border-bottom">
                    <i class="bi bi-person me-2 text-primary"></i>Bạn Đọc
                </div>
                <div class="card-body">
                    @if (Model.Reader != null)
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-5 text-muted">Mã bạn đọc</dt>
                            <dd class="col-sm-7 fw-bold">@Model.ReaderId</dd>

                            <dt class="col-sm-5 text-muted">Họ tên</dt>
                            <dd class="col-sm-7">@Model.Reader.FullName</dd>

                            <dt class="col-sm-5 text-muted">Email</dt>
                            <dd class="col-sm-7">@(Model.Reader.Email ?? "—")</dd>

                            <dt class="col-sm-5 text-muted">Điện thoại</dt>
                            <dd class="col-sm-7">@(Model.Reader.Phone ?? "—")</dd>
                        </dl>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Không tìm thấy thông tin bạn đọc.</p>
                    }
                </div>
            </div>
        </div>

        @* ── Danh sách sách mượn ── *@
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent fw-bold border-bottom">
                    <i class="bi bi-book me-2 text-primary"></i>
                    Sách Mượn
                    <span class="badge bg-primary ms-1">@Model.Books.Count</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Mã sách</th>
                                    <th>Tên sách</th>
                                    <th>Tác giả</th>
                                    <th>Tồn kho</th>
                                    <th class="pe-3">Trạng thái sách</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var book in Model.Books)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <code>@book.BookId</code>
                                        </td>
                                        <td class="fw-semibold">@book.Title</td>
                                        <td class="text-muted">@(book.Author ?? "—")</td>
                                        <td>
                                            <span class="badge @(book.Quantity <= 0 ? "bg-danger" : "bg-success")">
                                                @(book.Quantity ?? 0)
                                            </span>
                                        </td>
                                        <td class="pe-3">
                                            <span class="badge @(book.Status == "Có thể mượn" ? "bg-success" : "bg-secondary")">
                                                @(book.Status ?? "—")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@* ── Modal: Từ chối phiếu ── *@
<div class="modal fade" id="modalReject" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger">
                    <i class="bi bi-x-circle me-2"></i>Từ Chối Phiếu Mượn
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Reject" asp-route-id="@Model.TicketId" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p>Bạn có chắc chắn muốn từ chối phiếu mượn <strong>#@Model.TicketId</strong>?</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lý do từ chối (tùy chọn)</label>
                        <textarea name="reason" class="form-control" rows="3"
                                  placeholder="Nhập lý do từ chối…"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-lg me-1"></i>Xác nhận từ chối
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
