@using Core.Shared.Entities
@model List<Book>

@{
    ViewData["Title"] = "Quản lý sách";
    var categoriesJson = System.Text.Json.JsonSerializer.Serialize(
        (ViewBag.Categories as List<Category> ?? new List<Category>())
        .Select(c => new { id = c.CategoryId, name = c.CategoryName })
    );
}

<!-- ═══ TOAST ═══ -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toastBox" class="toast align-items-center border-0 text-white" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<!-- ═══ FORM XÓA NHIỀU ═══ -->
<form id="formDeleteMany" method="post"
      action="@Url.Action("DeleteMany", "Book")" class="d-none">
    @Html.AntiForgeryToken()
    <div id="hiddenDeleteIds"></div>
</form>

<!-- ═══ NỘI DUNG CHÍNH ═══ -->
<div class="container mt-4">
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h2><i class="fas fa-book"></i> Quản lý sách</h2>
        </div>
        <div class="col-md-6 text-end d-flex gap-2 justify-content-end flex-wrap">
            <button id="btnDeleteMany" class="btn btn-danger d-none"
                    onclick="openDeleteMany()">
                <i class="fas fa-trash"></i>
                Xóa đã chọn (<span id="selectedCount">0</span>)
            </button>
            <a href="@Url.Action("Create", "Book")" class="btn btn-success">
                <i class="fas fa-plus"></i> Thêm sách
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index")" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="searchTerm" class="form-control"
                           placeholder="Tìm kiếm theo tên sách hoặc tác giả..."
                           value="@ViewBag.SearchTerm">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:44px">
                                <input type="checkbox" id="chkAll" class="form-check-input"
                                       title="Chọn tất cả" onchange="toggleAll(this)">
                            </th>
                            <th>Mã sách</th>
                            <th>Hình ảnh</th>
                            <th>Tên sách</th>
                            <th>Tác giả</th>
                            <th>Thể loại</th>
                            <th>Số lượng</th>
                            <th>Tình trạng</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input chk-book"
                                           value="@book.BookId"
                                           data-title="@book.Title"
                                           onchange="updateSelected()">
                                </td>
                                <td><strong>@book.BookId</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(book.ImageUrl))
                                    {
                                        <img src="@book.ImageUrl" alt="@book.Title"
                                             width="60" height="80" class="img-thumbnail"
                                             style="object-fit:cover" />
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center
                                            justify-content-center rounded"
                                             style="width:60px;height:80px">
                                            <i class="fas fa-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td>@book.Title</td>
                                <td>@(book.Author ?? "-")</td>
                                <td>
                                    @if (book.BookCategories.Any())
                                    {
                                        @foreach (var bc in book.BookCategories)
                                        {
                                            <span class="badge bg-primary me-1">
                                                @bc.Category?.CategoryName
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(book.Quantity > 0 ? "bg-success" : "bg-danger")">
                                        @book.Quantity
                                    </span>
                                </td>
                                <td>@(book.Status ?? "Có thể mượn")</td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = book.BookId })"
                                           class="btn btn-sm btn-info" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = book.BookId })"
                                           class="btn btn-sm btn-warning" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = book.BookId })"
                                           class="btn btn-sm btn-danger" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            @(!string.IsNullOrEmpty(ViewBag.SearchTerm as string)
                ? "Không tìm thấy sách phù hợp với từ khóa tìm kiếm."
                : "Chưa có sách trong hệ thống.")
        </div>
    }
</div>

@section Scripts {
    <script>
        /* ══════════════════════════════════════════════
           TOAST
           ══════════════════════════════════════════════ */
        function showToast(msg, type) {
            const box = document.getElementById('toastBox');
            box.className = 'toast align-items-center border-0 text-white bg-' + type;
            document.getElementById('toastMsg').innerHTML = msg;
            new bootstrap.Toast(box, { delay: 3500 }).show();
        }

        /* ══════════════════════════════════════════════
           CHECKBOX
           ══════════════════════════════════════════════ */
        function toggleAll(chkAll) {
            document.querySelectorAll('.chk-book').forEach(c => c.checked = chkAll.checked);
            updateSelected();
        }

        function updateSelected() {
            const checked = document.querySelectorAll('.chk-book:checked');
            const total   = document.querySelectorAll('.chk-book').length;
            const count   = checked.length;
            document.getElementById('selectedCount').textContent = count;
            document.getElementById('btnDeleteMany').classList.toggle('d-none', count === 0);
            const chkAll = document.getElementById('chkAll');
            if (chkAll) {
                chkAll.indeterminate = count > 0 && count < total;
                chkAll.checked       = total > 0 && count === total;
            }
        }

        /* ══════════════════════════════════════════════
           XÓA NHIỀU
           ══════════════════════════════════════════════ */
        function openDeleteMany() {
            const checked = document.querySelectorAll('.chk-book:checked');
            if (!checked.length) return;

            const names = Array.from(checked)
                .map((c, i) => `${i + 1}. ${c.dataset.title} (${c.value})`)
                .join('\n');

            if (!confirm(`Xác nhận xóa ${checked.length} cuốn sách sau?\n\n${names}`)) return;

            document.getElementById('hiddenDeleteIds').innerHTML =
                Array.from(checked)
                    .map(c => `<input type="hidden" name="ids" value="${c.value}">`)
                    .join('');

            document.getElementById('formDeleteMany').submit();
        }

        /* ══════════════════════════════════════════════
           TOAST TỪ SERVER SAU REDIRECT
           ══════════════════════════════════════════════ */
        window.addEventListener('DOMContentLoaded', () => {
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>showToast('<i class="fas fa-check-circle me-2"></i>@Html.Raw(TempData["SuccessMessage"])', 'success');</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                    <text>showToast('<i class="fas fa-times-circle me-2"></i>@Html.Raw(TempData["ErrorMessage"])', 'danger');</text>
            }
        });
    </script>
}