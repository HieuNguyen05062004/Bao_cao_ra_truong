}

function backEditForm() {
    showStep(['stepEditForm','stepEditConfirm','stepEditLoading'], 'stepEditForm');
}

async function submitEdit() {
    showStep(['stepEditForm','stepEditConfirm','stepEditLoading'], 'stepEditLoading');
    const fd = new FormData();
    fd.append('BookId',      document.getElementById('e_BookId').value);
    fd.append('Title',       document.getElementById('e_Title').value.trim());
    fd.append('Author',      document.getElementById('e_Author').value.trim());
