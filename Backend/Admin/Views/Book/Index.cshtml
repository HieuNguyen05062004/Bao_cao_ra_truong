        : '<span class="text-muted">Giữ ảnh cũ</span>';

    showStep(['stepEditForm','stepEditConfirm','stepEditLoading'], 'stepEditConfirm');
}

function backEditForm() {
    showStep(['stepEditForm','stepEditConfirm','stepEditLoading'], 'stepEditForm');
}

async function submitEdit() {
