    document.getElementById('econf_Year').textContent      = document.getElementById('e_PublishYear').value || '-';
    document.getElementById('econf_Category').textContent  = getSelectedChipNames('e_CategoryChips','edit');
    document.getElementById('econf_Quantity').textContent  = qty;
    document.getElementById('econf_Status').textContent    = document.getElementById('e_Status').value;
    document.getElementById('econf_Image').innerHTML       = imgFile
