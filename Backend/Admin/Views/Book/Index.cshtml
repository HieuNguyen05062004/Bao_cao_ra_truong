@using Core.Shared.Entities
@model List<Book>

@{
    ViewData["Title"] = "Quản lý sách";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>
                <i class="fas fa-book"></i> Quản lý sách
            </h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Create")" class="btn btn-success">
                <i class="fas fa-plus"></i> Thêm sách
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tìm kiếm -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index")" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="searchTerm" class="form-control" placeholder="Tìm kiếm theo tên sách hoặc tác giả..." 
                           value="@ViewBag.SearchTerm">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách sách -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><i class="fas fa-barcode"></i> Mã sách</th>
                            <th><i class="fas fa-image"></i> Hình ảnh</th>
                            <th><i class="fas fa-book-open"></i> Tên sách</th>
                            <th><i class="fas fa-pen"></i> Tác giả</th>
                            <th><i class="fas fa-tag"></i> Thể loại</th>
                            <th><i class="fas fa-box"></i> Số lượng</th>
                            <th><i class="fas fa-info-circle"></i> Tình trạng</th>
                            <th><i class="fas fa-cogs"></i> Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@book.BookId</strong>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(book.ImageUrl))
                                    {
                                        <img src="@book.ImageUrl"
                                             alt="@book.Title"
                                             width="70"
                                             height="90"
                                             class="img-thumbnail"
                                             style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center justify-content-center rounded"
                                             style="width:70px; height:90px;">
                                            <i class="fas fa-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td>@book.Title</td>
                                <td>@(book.Author ?? "-")</td>
                                <td>@(book.Category?.CategoryName ?? "-")</td>
                                <td>
                                    <span class="badge @(book.Quantity > 0 ? "bg-success" : "bg-danger")">
                                        @book.Quantity
                                    </span>
                                </td>
                                <td>@(book.Status ?? "Có thể mượn")</td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = book.BookId })" class="btn btn-sm btn-info" title="Xem chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = book.BookId })" class="btn btn-sm btn-warning" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = book.BookId })" class="btn btn-sm btn-danger" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
            {
                <span>Không tìm thấy sách phù hợp với từ khóa tìm kiếm.</span>
            }
            else
            {
                <span>Chưa có sách trong hệ thống.</span>
            }
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }
</style>
