@using Core.Shared.Entities
@model List<Book>

@{
    ViewData["Title"] = "Quản lý sách";
}

<!-- ═══ TOAST ═══ -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toastBox" class="toast align-items-center border-0 text-white" role="alert">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<!-- ═══ MODAL THÊM SÁCH ═══ -->
<div class="modal fade" id="modalCreate" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-plus-circle me-2"></i>Thêm sách mới</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" onclick="resetCreate()"></button>
            </div>

            <!-- Bước 1: Form nhập -->
            <div id="stepCreateForm">
                <div class="modal-body">

                    <!-- Tên sách -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Tên sách <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="c_Title" class="form-control"
                               placeholder="Nhập tên sách" maxlength="255">
                        <div class="invalid-feedback">Tên sách không được để trống</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tác giả</label>
                            <input type="text" id="c_Author" class="form-control"
                                   placeholder="Nhập tên tác giả">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Nhà xuất bản</label>
                            <input type="text" id="c_Publisher" class="form-control"
                                   placeholder="Nhập tên NXB">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Năm xuất bản</label>
                            <input type="number" id="c_PublishYear" class="form-control"
                                   min="1000" max="2100" placeholder="VD: 2020">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Số lượng <span class="text-danger">*</span>
                            </label>
                            <input type="number" id="c_Quantity" class="form-control"
                                   min="0" value="1">
                            <div class="invalid-feedback">Số lượng không hợp lệ</div>
                        </div>
                    </div>

                    <!-- ── Chips chọn danh mục (nhiều) ── -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Thể loại</label>
                        <div id="c_CategoryChips" class="d-flex flex-wrap gap-2 mt-1">
                            @if (ViewBag.Categories != null)
                            {
                                @foreach (var cat in (List<Category>)ViewBag.Categories)
                                {
                                    <span class="chip badge rounded-pill border border-2
                                                 border-success text-success px-3 py-2
                                                 fs-6 cursor-pointer user-select-none"
                                          style="cursor:pointer;font-weight:500"
                                          data-id="@cat.CategoryId"
                                          onclick="toggleChip(this,'create')">
                                        @cat.CategoryName
                                    </span>
                                }
                            }
                        </div>
                        <small class="text-muted">Nhấn để chọn/bỏ chọn — có thể chọn nhiều</small>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tình trạng</label>
                            <input type="text" id="c_Status" class="form-control"
                                   value="Có thể mượn">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hình ảnh bìa</label>
                            <input type="file" id="c_ImageFile" class="form-control"
                                   accept="image/*">
                            <div id="c_ImagePreview" class="mt-2 d-none">
                                <img id="c_PreviewImg" src="" alt="preview"
                                     style="height:80px;object-fit:cover;
                                            border-radius:6px;border:1px solid #dee2e6">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal" onclick="resetCreate()">
                        <i class="fas fa-times"></i> Hủy
                    </button>
                    <button class="btn btn-success" onclick="toCreateConfirm()">
                        <i class="fas fa-arrow-right"></i> Tiếp theo
                    </button>
                </div>
            </div>

            <!-- Bước 2: Xác nhận -->
            <div id="stepCreateConfirm" class="d-none">
                <div class="modal-body">
                    <div class="alert alert-success py-2">
                        <i class="fas fa-check-circle me-2"></i>
                        Xác nhận thông tin sách trước khi lưu:
                    </div>
                    <table class="table table-bordered table-sm mb-0">
                        <tr><td class="fw-semibold bg-light" style="width:35%">Tên sách</td>
                            <td id="conf_Title"></td></tr>
                        <tr><td class="fw-semibold bg-light">Tác giả</td>
                            <td id="conf_Author"></td></tr>
                        <tr><td class="fw-semibold bg-light">Nhà xuất bản</td>
                            <td id="conf_Publisher"></td></tr>
                        <tr><td class="fw-semibold bg-light">Năm xuất bản</td>
                            <td id="conf_Year"></td></tr>
                        <tr><td class="fw-semibold bg-light">Thể loại</td>
                            <td id="conf_Category"></td></tr>
                        <tr><td class="fw-semibold bg-light">Số lượng</td>
                            <td id="conf_Quantity"></td></tr>
                        <tr><td class="fw-semibold bg-light">Tình trạng</td>
                            <td id="conf_Status"></td></tr>
                        <tr><td class="fw-semibold bg-light">Hình ảnh</td>
                            <td id="conf_Image"></td></tr>
                    </table>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" onclick="backCreateForm()">
                        <i class="fas fa-arrow-left"></i> Sửa lại
                    </button>
                    <button class="btn btn-success" onclick="submitCreate()">
                        <i class="fas fa-check"></i> Xác nhận thêm
                    </button>
                </div>
            </div>

            <!-- Loading -->
            <div id="stepCreateLoading" class="d-none">
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-success mb-3"></div>
                    <p class="text-muted mb-0">Đang lưu sách...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ MODAL SỬA SÁCH ═══ -->
<div class="modal fade" id="modalEdit" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i>Sửa thông tin sách</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Bước 1: Form sửa -->
            <div id="stepEditForm">
                <div class="modal-body">
                    <input type="hidden" id="e_BookId">
                    <input type="hidden" id="e_OldImageUrl">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã sách</label>
                        <input type="text" id="e_BookIdDisplay" class="form-control bg-light"
                               readonly>
                        <small class="text-muted">Mã sách không thể thay đổi</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Tên sách <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="e_Title" class="form-control" maxlength="255">
                        <div class="invalid-feedback">Tên sách không được để trống</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tác giả</label>
                            <input type="text" id="e_Author" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Nhà xuất bản</label>
                            <input type="text" id="e_Publisher" class="form-control">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Năm xuất bản</label>
                            <input type="number" id="e_PublishYear" class="form-control"
                                   min="1000" max="2100">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Số lượng <span class="text-danger">*</span>
                            </label>
                            <input type="number" id="e_Quantity" class="form-control" min="0">
                            <div class="invalid-feedback">Số lượng không hợp lệ</div>
                        </div>
                    </div>

                    <!-- ── Chips chọn danh mục (Edit) ── -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Thể loại</label>
                        <div id="e_CategoryChips" class="d-flex flex-wrap gap-2 mt-1">
                            @if (ViewBag.Categories != null)
                            {
                                @foreach (var cat in (List<Category>)ViewBag.Categories)
                                {
                                    <span class="chip badge rounded-pill border border-2
                                                 border-warning text-warning px-3 py-2
                                                 fs-6 user-select-none"
                                          style="cursor:pointer;font-weight:500"
                                          data-id="@cat.CategoryId"
                                          onclick="toggleChip(this,'edit')">
                                        @cat.CategoryName
                                    </span>
                                }
                            }
                        </div>
                        <small class="text-muted">Nhấn để chọn/bỏ chọn — có thể chọn nhiều</small>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tình trạng</label>
                            <input type="text" id="e_Status" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hình ảnh bìa mới</label>
                            <input type="file" id="e_ImageFile" class="form-control"
                                   accept="image/*">
                            <div class="mt-2" id="e_CurrentImageWrap">
                                <small class="text-muted">Ảnh hiện tại:</small><br>
                                <img id="e_CurrentImg" src="" alt="current"
                                     style="height:70px;object-fit:cover;
                                            border-radius:4px;border:1px solid #dee2e6">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Hủy
                    </button>
                    <button class="btn btn-warning" onclick="toEditConfirm()">
                        <i class="fas fa-arrow-right"></i> Tiếp theo
                    </button>
                </div>
            </div>

            <!-- Bước 2: Xác nhận sửa -->
            <div id="stepEditConfirm" class="d-none">
                <div class="modal-body">
                    <div class="alert alert-warning py-2">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        Xác nhận cập nhật thông tin sách?
                    </div>
                    <table class="table table-bordered table-sm mb-0">
                        <tr><td class="fw-semibold bg-light" style="width:35%">Mã sách</td>
                            <td id="econf_BookId"></td></tr>
                        <tr><td class="fw-semibold bg-light">Tên sách</td>
                            <td id="econf_Title"></td></tr>
                        <tr><td class="fw-semibold bg-light">Tác giả</td>
                            <td id="econf_Author"></td></tr>
                        <tr><td class="fw-semibold bg-light">Nhà xuất bản</td>
                            <td id="econf_Publisher"></td></tr>
                        <tr><td class="fw-semibold bg-light">Năm xuất bản</td>
                            <td id="econf_Year"></td></tr>
                        <tr><td class="fw-semibold bg-light">Thể loại</td>
                            <td id="econf_Category"></td></tr>
                        <tr><td class="fw-semibold bg-light">Số lượng</td>
                            <td id="econf_Quantity"></td></tr>
                        <tr><td class="fw-semibold bg-light">Tình trạng</td>
                            <td id="econf_Status"></td></tr>
                        <tr><td class="fw-semibold bg-light">Ảnh mới</td>
                            <td id="econf_Image"></td></tr>
                    </table>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" onclick="backEditForm()">
                        <i class="fas fa-arrow-left"></i> Sửa lại
                    </button>
                    <button class="btn btn-warning" onclick="submitEdit()">
                        <i class="fas fa-check"></i> Xác nhận lưu
                    </button>
                </div>
            </div>

            <!-- Loading -->
            <div id="stepEditLoading" class="d-none">
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-warning mb-3"></div>
                    <p class="text-muted mb-0">Đang cập nhật...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ MODAL XÓA ═══ (giữ nguyên) -->
<div class="modal fade" id="modalDelete" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-trash-alt me-2"></i>Xác nhận xóa sách
                </h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning py-2">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Hành động này <strong>không thể hoàn tác</strong>!
                </div>
                <p id="deleteMsg" class="mb-2"></p>
                <div id="deleteManyList" class="d-none small text-muted"
                     style="max-height:160px;overflow-y:auto;
                            border:1px solid #dee2e6;border-radius:6px;padding:8px"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Hủy
                </button>
                <form id="formDelete" method="post"
                      action="@Url.Action("DeleteMany","Book")">
                    @Html.AntiForgeryToken()
                    <div id="hiddenDeleteIds"></div>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt"></i> Xác nhận xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ═══ NỘI DUNG CHÍNH ═══ -->
<div class="container mt-4">
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h2><i class="fas fa-book"></i> Quản lý sách</h2>
        </div>
        <div class="col-md-6 text-end d-flex gap-2 justify-content-end flex-wrap">
            <button id="btnDeleteMany" class="btn btn-danger d-none"
                    onclick="openDeleteMany()">
                <i class="fas fa-trash"></i>
                Xóa đã chọn (<span id="selectedCount">0</span>)
            </button>
            <button class="btn btn-success" onclick="openCreate()">
                <i class="fas fa-plus"></i> Thêm sách
            </button>
        </div>
    </div>

    <!-- Tìm kiếm -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index")" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="searchTerm" class="form-control"
                           placeholder="Tìm kiếm theo tên sách hoặc tác giả..."
                           value="@ViewBag.SearchTerm">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:44px">
                                <input type="checkbox" id="chkAll" class="form-check-input"
                                       title="Chọn tất cả" onchange="toggleAll(this)">
                            </th>
                            <th>Mã sách</th>
                            <th>Hình ảnh</th>
                            <th>Tên sách</th>
                            <th>Tác giả</th>
                            <th>Thể loại</th>
                            <th>Số lượng</th>
                            <th>Tình trạng</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model)
                        {
                            var catIds = book.BookCategories
                                             .Select(bc => bc.CategoryId)
                                             .ToList();

                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input chk-book"
                                           value="@book.BookId"
                                           data-title="@book.Title"
                                           onchange="updateSelected()">
                                </td>
                                <td><strong>@book.BookId</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(book.ImageUrl))
                                    {
                                        <img src="@book.ImageUrl" alt="@book.Title"
                                             width="60" height="80"
                                             class="img-thumbnail"
                                             style="object-fit:cover"/>
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center
                                                    justify-content-center rounded"
                                             style="width:60px;height:80px">
                                            <i class="fas fa-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td>@book.Title</td>
                                <td>@(book.Author ?? "-")</td>
                                <td>
                                    @if (book.BookCategories.Any())
                                    {
                                        @foreach (var bc in book.BookCategories)
                                        {
                                            <span class="badge bg-primary me-1">
                                                @bc.Category?.CategoryName
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(book.Quantity > 0 ? "bg-success" : "bg-danger")">
                                        @book.Quantity
                                    </span>
                                </td>
                                <td>@(book.Status ?? "Có thể mượn")</td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = book.BookId })"
                                       class="btn btn-sm btn-info" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <button class="btn btn-sm btn-warning" title="Sửa"
                                            onclick='openEdit(@Html.Raw(
                                                System.Text.Json.JsonSerializer.Serialize(new {
                                                    bookId    = book.BookId,
                                                    title     = book.Title,
                                                    author    = book.Author,
                                                    publisher = book.Publisher,
                                                    year      = book.PublishYear,
                                                    catIds    = catIds,   // mảng nhiều ID
                                                    qty       = book.Quantity,
                                                    status    = book.Status,
                                                    imageUrl  = book.ImageUrl
                                                })))'>
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" title="Xóa"
                                            onclick="openDeleteOne('@book.BookId',
                                                '@Html.Raw(book.Title?.Replace("'","\\'") ?? "")')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            @(!string.IsNullOrEmpty(ViewBag.SearchTerm as string)
                ? "Không tìm thấy sách phù hợp với từ khóa tìm kiếm."
                : "Chưa có sách trong hệ thống.")
        </div>
    }
</div>

<style>
/* ── Chip thể loại ── */
.chip {
    transition: all .18s ease;
    font-size: .85rem !important;
}
.chip.selected-create {
    background-color: #198754 !important;
    color: #fff !important;
    border-color: #198754 !important;
}
.chip.selected-edit {
    background-color: #ffc107 !important;
    color: #000 !important;
    border-color: #ffc107 !important;
}
.chip:hover { opacity: .85; transform: scale(1.04); }
</style>

@section Scripts {
<script>
/* ══════════════════════════════════════════════
   CHIP LOGIC — dùng chung Create / Edit
   ══════════════════════════════════════════════ */

/**
 * Toggle (bật/tắt) chip khi click.
 * mode = 'create' | 'edit'
 */
function toggleChip(el, mode) {
    el.classList.toggle('selected-' + mode);
}

/**
 * Lấy danh sách CategoryId đã chọn từ chip container.
 * containerId: ID của div chứa chips.
 * mode: 'create' | 'edit'
 */
function getSelectedChipIds(containerId, mode) {
    return Array.from(
        document.querySelectorAll(`#${containerId} .chip.selected-${mode}`)
    ).map(el => parseInt(el.dataset.id));
}

/**
 * Lấy tên các chip đang được chọn (để hiển thị trong bảng xác nhận).
 */
function getSelectedChipNames(containerId, mode) {
    const names = Array.from(
        document.querySelectorAll(`#${containerId} .chip.selected-${mode}`)
    ).map(el => el.textContent.trim());
    return names.length ? names.join(', ') : '-';
}

/**
 * Set trạng thái chip theo mảng IDs (dùng khi mở modal Edit).
 */
function setChips(containerId, mode, ids) {
    document.querySelectorAll(`#${containerId} .chip`).forEach(el => {
        el.classList.remove('selected-' + mode);
        if (ids.includes(parseInt(el.dataset.id)))
            el.classList.add('selected-' + mode);
    });
}

/* ══════════════════════════════════════════════
   TOAST
   ══════════════════════════════════════════════ */
function showToast(msg, type) {
    const box = document.getElementById('toastBox');
    box.className = 'toast align-items-center border-0 text-white bg-' + type;
    document.getElementById('toastMsg').innerHTML = msg;
    new bootstrap.Toast(box, { delay: 3500 }).show();
}

/* ══════════════════════════════════════════════
   HELPER BƯỚC
   ══════════════════════════════════════════════ */
function showStep(list, activeId) {
    list.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('d-none', id !== activeId);
    });
}

/* ══════════════════════════════════════════════
   THÊM SÁCH
   ══════════════════════════════════════════════ */
function openCreate() {
    resetCreate();
    new bootstrap.Modal(document.getElementById('modalCreate')).show();
}

function resetCreate() {
    ['c_Title','c_Author','c_Publisher'].forEach(id => {
        const el = document.getElementById(id); if (el) el.value = '';
    });
    document.getElementById('c_Status').value      = 'Có thể mượn';
    document.getElementById('c_Quantity').value    = 1;
    document.getElementById('c_PublishYear').value = '';
    document.getElementById('c_ImageFile').value   = '';
    document.getElementById('c_ImagePreview').classList.add('d-none');
    // Bỏ chọn tất cả chip Create
    document.querySelectorAll('#c_CategoryChips .chip').forEach(el =>
        el.classList.remove('selected-create')
    );
    document.querySelectorAll('#modalCreate .is-invalid').forEach(el =>
        el.classList.remove('is-invalid')
    );
    showStep(['stepCreateForm','stepCreateConfirm','stepCreateLoading'], 'stepCreateForm');
}

document.getElementById('c_ImageFile').addEventListener('change', function () {
    const file = this.files[0];
    if (file) {
        document.getElementById('c_PreviewImg').src = URL.createObjectURL(file);
        document.getElementById('c_ImagePreview').classList.remove('d-none');
    } else {
        document.getElementById('c_ImagePreview').classList.add('d-none');
    }
});

function toCreateConfirm() {
    let ok = true;
    const title = document.getElementById('c_Title').value.trim();
    const qty   = parseInt(document.getElementById('c_Quantity').value);

    const setErr = (id, isErr) =>
        document.getElementById(id).classList.toggle('is-invalid', isErr);

    setErr('c_Title',    !title);                    if (!title) ok = false;
    setErr('c_Quantity', isNaN(qty) || qty < 0);     if (isNaN(qty) || qty < 0) ok = false;
    if (!ok) return;

    const imgFile = document.getElementById('c_ImageFile').files[0];
    document.getElementById('conf_Title').textContent     = title;
    document.getElementById('conf_Author').textContent    = document.getElementById('c_Author').value || '-';
    document.getElementById('conf_Publisher').textContent = document.getElementById('c_Publisher').value || '-';
    document.getElementById('conf_Year').textContent      = document.getElementById('c_PublishYear').value || '-';
    document.getElementById('conf_Category').textContent  = getSelectedChipNames('c_CategoryChips','create');
    document.getElementById('conf_Quantity').textContent  = qty;
    document.getElementById('conf_Status').textContent    = document.getElementById('c_Status').value || 'Có thể mượn';
    document.getElementById('conf_Image').innerHTML       = imgFile
        ? `<span class="text-success"><i class="fas fa-file-image me-1"></i>${imgFile.name}</span>`
        : '<span class="text-muted">Không có</span>';

    showStep(['stepCreateForm','stepCreateConfirm','stepCreateLoading'], 'stepCreateConfirm');
}

function backCreateForm() {
    showStep(['stepCreateForm','stepCreateConfirm','stepCreateLoading'], 'stepCreateForm');
}

async function submitCreate() {
    showStep(['stepCreateForm','stepCreateConfirm','stepCreateLoading'], 'stepCreateLoading');

    const fd = new FormData();
    // Không gửi BookId — server tự sinh
    fd.append('Title',       document.getElementById('c_Title').value.trim());
    fd.append('Author',      document.getElementById('c_Author').value.trim());
    fd.append('Publisher',   document.getElementById('c_Publisher').value.trim());
    fd.append('PublishYear', document.getElementById('c_PublishYear').value);
    fd.append('Quantity',    document.getElementById('c_Quantity').value);
    fd.append('Status',      document.getElementById('c_Status').value);

    // Gửi nhiều CategoryIds
    getSelectedChipIds('c_CategoryChips','create').forEach(id =>
        fd.append('CategoryIds', id)
    );

    const imgFile = document.getElementById('c_ImageFile').files[0];
    if (imgFile) fd.append('ImageFile', imgFile);

    fd.append('__RequestVerificationToken',
        document.querySelector('input[name="__RequestVerificationToken"]').value);

    try {
        const res  = await fetch('@Url.Action("CreateAjax","Book")',
                                  { method: 'POST', body: fd });
        const data = await res.json();
        bootstrap.Modal.getInstance(document.getElementById('modalCreate')).hide();
        showToast(
            `<i class="fas fa-${data.success ? 'check' : 'times'}-circle me-2"></i>${data.message}`,
            data.success ? 'success' : 'danger'
        );
        if (data.success) setTimeout(() => location.reload(), 1800);
    } catch {
        bootstrap.Modal.getInstance(document.getElementById('modalCreate')).hide();
        showToast('<i class="fas fa-times-circle me-2"></i>Lỗi kết nối. Vui lòng thử lại.', 'danger');
    }
}

/* ══════════════════════════════════════════════
   SỬA SÁCH
   ══════════════════════════════════════════════ */
function openEdit(book) {
    document.getElementById('e_BookId').value        = book.bookId;
    document.getElementById('e_BookIdDisplay').value = book.bookId;
    document.getElementById('e_Title').value         = book.title     || '';
    document.getElementById('e_Author').value        = book.author    || '';
    document.getElementById('e_Publisher').value     = book.publisher || '';
    document.getElementById('e_PublishYear').value   = book.year      || '';
    document.getElementById('e_Quantity').value      = book.qty       ?? 0;
    document.getElementById('e_Status').value        = book.status    || 'Có thể mượn';
    document.getElementById('e_OldImageUrl').value   = book.imageUrl  || '';
    document.getElementById('e_ImageFile').value     = '';

    // Highlight chip theo danh mục hiện có của sách
    setChips('e_CategoryChips', 'edit', book.catIds || []);

    const wrap = document.getElementById('e_CurrentImageWrap');
    if (book.imageUrl) {
        document.getElementById('e_CurrentImg').src = book.imageUrl;
        wrap.classList.remove('d-none');
    } else {
        wrap.classList.add('d-none');
    }

    document.querySelectorAll('#modalEdit .is-invalid').forEach(el =>
        el.classList.remove('is-invalid')
    );
    showStep(['stepEditForm','stepEditConfirm','stepEditLoading'], 'stepEditForm');
    new bootstrap.Modal(document.getElementById('modalEdit')).show();
}

function toEditConfirm() {
    let ok = true;
    const title = document.getElementById('e_Title').value.trim();
    const qty   = parseInt(document.getElementById('e_Quantity').value);
    const setErr = (id, isErr) =>
        document.getElementById(id).classList.toggle('is-invalid', isErr);
