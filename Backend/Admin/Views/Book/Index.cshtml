    }
}

/* ══════════════════════════════════════════════
   XÓA
   ══════════════════════════════════════════════ */
function openDeleteOne(id, title) {
    document.getElementById('deleteMsg').innerHTML =
        `Bạn có chắc muốn xóa cuốn sách <strong class="text-danger">"${title}"</strong>?`;
    document.getElementById('deleteManyList').classList.add('d-none');
    document.getElementById('hiddenDeleteIds').innerHTML =
        `<input type="hidden" name="ids" value="${id}">`;
    new bootstrap.Modal(document.getElementById('modalDelete')).show();
}

function openDeleteMany() {
    const checked = document.querySelectorAll('.chk-book:checked');
    if (!checked.length) return;
    document.getElementById('deleteMsg').innerHTML =
        `Bạn có chắc muốn xóa <strong class="text-danger">${checked.length} cuốn sách</strong> đã chọn?`;
    const list = document.getElementById('deleteManyList');
    list.innerHTML = Array.from(checked)
        .map((c,i) => `<div>${i+1}. <strong>${c.dataset.title}</strong>
                       <span class="text-muted">(${c.value})</span></div>`)
        .join('');
    list.classList.remove('d-none');
    document.getElementById('hiddenDeleteIds').innerHTML = Array.from(checked)
        .map(c => `<input type="hidden" name="ids" value="${c.value}">`)
        .join('');
    new bootstrap.Modal(document.getElementById('modalDelete')).show();
}

/* ══════════════════════════════════════════════
   CHECKBOX
   ══════════════════════════════════════════════ */
function toggleAll(chkAll) {
    document.querySelectorAll('.chk-book').forEach(c => c.checked = chkAll.checked);
    updateSelected();
}
function updateSelected() {
    const checked = document.querySelectorAll('.chk-book:checked');
    const total   = document.querySelectorAll('.chk-book').length;
    const count   = checked.length;
    document.getElementById('selectedCount').textContent = count;
    document.getElementById('btnDeleteMany').classList.toggle('d-none', count === 0);
    const chkAll = document.getElementById('chkAll');
    if (chkAll) {
        chkAll.indeterminate = count > 0 && count < total;
        chkAll.checked = total > 0 && count === total;
    }
}

