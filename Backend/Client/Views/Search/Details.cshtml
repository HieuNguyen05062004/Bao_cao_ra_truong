@using Core.Shared.Entities
@model Book

@{
    ViewData["Title"] = "Chi tiết sách";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            @if (Model != null)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-4">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded" style="max-height: 300px;">
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 300px;">
                                        <i class="fas fa-book fa-5x text-muted"></i>
                                    </div>
                                }
                            </div>
                            <div class="col-md-8">
                                <h3 class="mb-3">@Model.Title</h3>

                                <div class="mb-3">
                                    <strong>Mã sách:</strong>
                                    <p class="text-muted">@Model.BookId</p>
                                </div>

                                <div class="mb-3">
                                    <strong>Tác giả:</strong>
                                    <p class="text-muted">@(Model.Author ?? "-")</p>
                                </div>

                                <div class="mb-3">
                                    <strong>Nhà xuất bản:</strong>
                                    <p class="text-muted">@(Model.Publisher ?? "-")</p>
                                </div>

                                <div class="mb-3">
                                    <strong>Năm xuất bản:</strong>
                                    <p class="text-muted">@(Model.PublishYear?.ToString() ?? "-")</p>
                                </div>

                                <div class="mb-3">
                                    <strong>Thể loại:</strong>
                                    <p>
                                        @if (Model.Category != null)
                                        {
                                            <span class="badge bg-primary">@Model.Category.CategoryName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </p>
                                </div>

                                <div class="mb-3">
                                    <strong>Tình trạng:</strong>
                                    <p>
                                        @if (Model.Quantity > 0)
                                        {
                                            <span class="badge bg-success">Còn hàng (@Model.Quantity)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Hết hàng</span>
                                        }
                                    </p>
                                </div>

                                <div class="mt-4 d-flex gap-2">
                                    <a href="@Url.Action("Index", "Search")" class="btn btn-secondary">
                                        <i class="fas fa-arrow-left"></i> Quay lại
                                    </a>
                                    @if (Model.Quantity > 0)
                                    {
                                        <button class="btn btn-primary" onclick="alert('Chức năng mượn sách đang được phát triển')">
                                            <i class="fas fa-book"></i> Gửi yêu cầu mượn
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center py-5">
                    <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                    <p>Không tìm thấy thông tin sách</p>
                    <a href="@Url.Action("Index", "Search")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            }
        </div>
    </div>
</div>
