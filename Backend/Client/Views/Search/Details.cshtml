@using Core.Shared.Entities
@model Book

@{
    ViewData["Title"] = "Chi tiết sách";
    var isLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString("ReaderId"));
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            @if (Model != null)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-4">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl"
                                         alt="@Model.Title"
                                         class="img-fluid rounded shadow"
                                         style="height: 320px; width: 100%; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center rounded shadow"
                                         style="height: 320px; width: 100%;">
                                        <i class="fas fa-book fa-4x text-muted"></i>
                                    </div>
                                }
                            </div>
                            <div class="col-md-8">
                                <h3 class="mb-3">@Model.Title</h3>

                                <div class="mb-3">
                                    <strong>Mã sách:</strong>
                                    <p class="text-muted">@Model.BookId</p>
                                </div>

                                <div class="mb-3">
                                    <strong>Tác giả:</strong>
                                    <p class="text-muted">@(Model.Author ?? "-")</p>
                                </div>

                                <div class="mb-3">
                                    <strong>Nhà xuất bản:</strong>
                                    <p class="text-muted">@(Model.Publisher ?? "-")</p>
                                </div>

                                <div class="mb-3">
                                    <strong>Năm xuất bản:</strong>
                                    <p class="text-muted">@(Model.PublishYear?.ToString() ?? "-")</p>
                                </div>

                                <div class="mb-3">
                                    <strong>Thể loại:</strong>
                                    <p>
                                        @{
                                            var categoryNames = Model.BookCategories?
                                                .Select(bc => bc.Category?.CategoryName)
                                                .Where(c => c != null).ToList();
                                        }
                                        @if (categoryNames?.Count > 0)
                                        {
                                            foreach (var catName in categoryNames)
                                            {
                                                <span class="badge bg-primary">@catName</span>
                                                <text> </text>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </p>
                                </div>

                                <div class="mb-3">
                                    <strong>Tình trạng:</strong>
                                    <p>
                                        @if (Model.Quantity > 0)
                                        {
                                            <span class="badge bg-success">Còn hàng (@Model.Quantity)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Hết hàng</span>
                                        }
                                    </p>
                                </div>

                                <div class="mt-4 d-flex gap-2 flex-wrap">
                                    <a href="@Url.Action("Index", "Search")" class="btn btn-secondary">
                                        <i class="fas fa-arrow-left"></i> Quay lại
                                    </a>

                                    @if (Model.Quantity > 0)
                                    {
                                        @if (isLoggedIn)
                                        {
                                            @* Đã đăng nhập → mượn ngay *@
                                            <a href="@Url.Action("CreateBorrowRequest", "Borrow",
                                                                                                                                                       new { bookIds = Model.BookId })"
                                                   class="btn btn-primary">
                                                <i class="fas fa-book-reader me-1"></i> Gửi yêu cầu mượn
                                            </a>
                                        }
                                        else
                                        {
                                            @* Chưa đăng nhập → về Login *@
                                            <a href="@Url.Action("Login", "Account")"
                                                   class="btn btn-primary">
                                                <i class="fas fa-sign-in-alt me-1"></i> Đăng nhập để mượn
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary" disabled>
                                            <i class="fas fa-times-circle me-1"></i> Sách tạm hết
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center py-5">
                    <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                    <p>Không tìm thấy thông tin sách</p>
                    <a href="@Url.Action("Index", "Search")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            }
        </div>
    </div>
</div>
