@using Core.Shared.Entities
@model List<Book>

@{
    ViewData["Title"] = "Tìm kiếm sách";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>
                <i class="fas fa-search"></i> Tìm kiếm sách
            </h2>
        </div>
    </div>

    <!-- Thanh tìm kiếm -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index")" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="searchTerm" class="form-control" placeholder="Tìm kiếm theo tên sách hoặc tác giả..." 
                           value="@ViewBag.SearchTerm">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Lọc theo thể loại -->
    @if (ViewBag.Categories != null && ((List<Category>)ViewBag.Categories).Count > 0)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="mb-3">Lọc theo thể loại:</h6>
                <div class="btn-group" role="group">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary @(ViewBag.SelectedCategory == 0 ? "active" : "")">
                        <i class="fas fa-list"></i> Tất cả
                    </a>
                    @foreach (var category in (List<Category>)ViewBag.Categories)
                    {
                        <a href="@Url.Action("Index", new { categoryId = category.CategoryId })" 
                           class="btn btn-outline-secondary @(ViewBag.SelectedCategory == category.CategoryId ? "active" : "")">
                            @category.CategoryName
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Danh sách sách -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row">
            @foreach (var book in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(book.ImageUrl))
                        {
                            <img src="@book.ImageUrl" class="card-img-top" alt="@book.Title" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="fas fa-book fa-4x text-muted"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@book.Title</h5>
                            <p class="card-text text-muted">
                                <small>
                                    <strong>Tác giả:</strong> @(book.Author ?? "-")
                                </small>
                            </p>
                            <p class="card-text text-muted">
                                <small>
                                    <strong>Thể loại:</strong> 
                                    @{
                                        var categoryNames = book.BookCategories?.Select(bc => bc.Category?.CategoryName).Where(c => c != null).ToList();
                                        if (categoryNames?.Count > 0)
                                        {
                                            @string.Join(", ", categoryNames)
                                        }
                                        else
                                        {
                                            <text>-</text>
                                        }
                                    }
                                </small>
                            </p>
                            <div class="mb-3">
                                @if (book.Quantity > 0)
                                {
                                    <span class="badge bg-success">Còn hàng (@book.Quantity)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Hết hàng</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-white">
                            <a href="@Url.Action("Details", new { id = book.BookId })" class="btn btn-primary btn-sm w-100">
                                <i class="fas fa-eye"></i> Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-info-circle fa-3x mb-3"></i>
            <p>
                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                {
                    <span>Không tìm thấy sách phù hợp với từ khóa tìm kiếm.</span>
                }
                else
                {
                    <span>Không có sách nào trong thể loại này hoặc hiện tại không có sách nào.</span>
                }
            </p>
        </div>
    }
</div>
