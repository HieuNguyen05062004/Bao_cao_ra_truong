@using Core.Shared.Entities
@model List<Book>

@{
    ViewData["Title"] = "Tìm kiếm sách";
    bool isAiSearch = ViewBag.IsAiSearch == true;
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2><i class="fas fa-search"></i> Tìm kiếm sách</h2>
        </div>
    </div>

    <!-- ── Tìm kiếm thường ── -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index")" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="searchTerm" class="form-control"
                           placeholder="Tìm theo tên sách hoặc tác giả..."
                           value="@(isAiSearch ? "" : ViewBag.SearchTerm)" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ── Tìm kiếm AI ── -->
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white py-2">
            <i class="fas fa-robot"></i> <strong>Tìm kiếm bằng ngôn ngữ tự nhiên (AI)</strong>
        </div>
        <div class="card-body">
            <form method="post" action="@Url.Action("AiSearch")">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-10">
                        <input type="text" name="aiQuery" class="form-control"
                               placeholder="VD: sách lập trình Python cho người mới, tiểu thuyết lãng mạn của Nguyễn Nhật Ánh..."
                               value="@(isAiSearch ? ViewBag.OriginalAiQuery : "")" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-outline-primary w-100">
                            <i class="fas fa-magic"></i> Tìm với AI
                        </button>
                    </div>
                </div>
                <div class="mt-2">
                    <small class="text-muted">
                        <i class="fas fa-info-circle"></i>
                        AI sẽ hiểu câu hỏi của bạn và tìm sách phù hợp nhất.
                    </small>
                </div>
            </form>
        </div>
    </div>

    <!-- ── Kết quả AI diễn giải ── -->
    @if (isAiSearch && ViewBag.AiInterpretedQuery != null)
    {
        <div class="alert alert-primary d-flex align-items-center mb-3" role="alert">
            <i class="fas fa-robot me-2 fs-5"></i>
            <div>
                <strong>AI hiểu:</strong> @ViewBag.AiInterpretedQuery
                <span class="ms-2 text-muted small">(tìm với từ khóa: "<em>@ViewBag.SearchTerm</em>")</span>
            </div>
        </div>
    }

    <!-- ── Lọc theo thể loại ── -->
    @if (ViewBag.Categories != null && ((List<Category>)ViewBag.Categories).Count > 0)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="mb-3">Lọc theo thể loại:</h6>
                <div class="btn-group flex-wrap" role="group">
                    <a href="@Url.Action("Index")"
                           class="btn btn-outline-secondary @(ViewBag.SelectedCategory == 0 && !isAiSearch ? "active" : "")">
                        <i class="fas fa-list"></i> Tất cả
                    </a>
                    @foreach (var category in (List<Category>)ViewBag.Categories)
                    {
                        <a href="@Url.Action("Index", new { categoryId = category.CategoryId })"
                               class="btn btn-outline-secondary @(ViewBag.SelectedCategory == category.CategoryId ? "active" : "")">
                            @category.CategoryName
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ── Thông báo lỗi ── -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ── Danh sách sách ── -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row">
            @foreach (var book in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(book.ImageUrl))
                        {
                            <img src="@book.ImageUrl" class="card-img-top" alt="@book.Title"
                                 style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <i class="fas fa-book fa-4x text-muted"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@book.Title</h5>
                            <p class="card-text text-muted">
                                <small><strong>Tác giả:</strong> @(book.Author ?? "-")</small>
                            </p>
                            <p class="card-text text-muted">
                                <small>
                                    <strong>Thể loại:</strong>
                                    @{
                                        var categoryNames = book.BookCategories?
                                            .Select(bc => bc.Category?.CategoryName)
                                            .Where(c => c != null)
                                            .ToList();
                                        if (categoryNames?.Count > 0)
                                        {
                                            @string.Join(", ", categoryNames)
                                        }
                                        else
                                        {

                                            <text>-</text>
                                        }
                                    }
                                </small>
                            </p>
                            <div class="mb-3">
                                @if (book.Quantity > 0)
                                {
                                    <span class="badge bg-success">Còn hàng (@book.Quantity)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Hết hàng</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-white">
                            <a href="@Url.Action("Details", new { id = book.BookId })"
                                   class="btn btn-primary btn-sm w-100">
                                <i class="fas fa-eye"></i> Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-info-circle fa-3x mb-3 d-block"></i>
            @if (isAiSearch)
            {
                <span>AI không tìm thấy sách phù hợp với "<strong>@ViewBag.OriginalAiQuery</strong>". Thử diễn đạt khác nhé!</span>
            }
            else if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <span>Không tìm thấy sách phù hợp với từ khóa tìm kiếm.</span>
            }
            else
            {
                <span>Không có sách nào trong thể loại này hoặc hiện tại không có sách nào.</span>
            }
        </div>
    }
</div>
