@using Core.Shared.Entities
@model Client.ViewModels.BookListViewModel

@{
    ViewData["Title"] = "Kho Tài Liệu Số";

    // Helper: build URL giữ nguyên toàn bộ filter, chỉ thay số trang
    string PageUrl(int p)
    {
        var qs = new System.Text.StringBuilder($"?page={p}");
        if (!string.IsNullOrWhiteSpace(Model.Keyword))
            qs.Append($"&keyword={Uri.EscapeDataString(Model.Keyword)}");
        foreach (var id in Model.SelectedCategoryIds)
            qs.Append($"&categoryIds={id}");
        if (Model.Sort != "newest")
            qs.Append($"&sort={Model.Sort}");
        return Url.Action("Index", "Search") + qs;
    }
}

<!-- ══ HERO / SEARCH ══════════════════════════════════════════════════════ -->
<section class="cat-hero">
    <div class="container">
        <p class="cat-eyebrow">Thư viện học thuật trực tuyến</p>
        <h1 class="cat-heading">Kho Tài Liệu Số</h1>
        <p class="cat-sub">Khám phá hàng nghìn đầu sách và tài liệu nghiên cứu được hỗ trợ bởi AI.</p>

        <!-- Search box -->
        <div class="cat-search-box">
            <!-- Tabs -->
            <div class="search-tabs mb-3">
                <button class="stab @(!Model.IsAiSearch ? "active" : "")"
                        id="tab-normal" onclick="switchTab('normal')">
                    <i class="fas fa-search"></i> Tìm kiếm thường
                </button>
                <button class="stab @(Model.IsAiSearch ? "active" : "")"
                        id="tab-ai" onclick="switchTab('ai')">
                    <i class="fas fa-robot"></i> Tích hợp AI tìm kiếm nâng cao
                    <span class="badge-beta">Advanced search</span>
                </button>
            </div>

            <!-- Form tìm kiếm thường — GET, giữ categoryIds + sort -->
            <form id="form-normal" method="get"
                  asp-action="Index" asp-controller="Search"
                  class="cat-search-form @(Model.IsAiSearch ? "d-none" : "")">
                <div id="catInputsSearch">
                    @foreach (var id in Model.SelectedCategoryIds)
                    {
                        <input type="hidden" name="categoryIds" value="@id" />
                    }
                </div>
                <input type="hidden" name="sort" value="@Model.Sort" />
                <i class="fas fa-search search-ico-inside"></i>
                <input type="text" name="keyword" value="@Model.Keyword"
                       placeholder="Tìm theo tên sách hoặc tác giả..."
                       class="cat-search-input" autocomplete="off" />
                <button type="submit" class="cat-search-btn">Tìm kiếm</button>
            </form>

            <!-- Form tích hợp AI tìm kiếm nâng cao — POST -->
            <form id="form-ai" method="post"
                  asp-action="AiSearch" asp-controller="Search"
                  class="cat-search-form @(!Model.IsAiSearch ? "d-none" : "")">
                @Html.AntiForgeryToken()
                <i class="fas fa-robot search-ico-inside text-primary"></i>
                <input type="text" name="aiQuery" value="@Model.OriginalAiQuery"
                      
                       class="cat-search-input" autocomplete="off" />
                <button type="submit" class="cat-search-btn ai-btn">
                    <i class="fas fa-magic me-1"></i>Tìm kiếm nâng cao
                </button>
            </form>
        </div>

        <!-- Category chips — nằm trong hero, submit form-normal -->
        <div class="chips-row mt-3" id="filterForm">
            <!-- Hidden inputs được JS cập nhật -->
            <div id="catInputs">
                @foreach (var id in Model.SelectedCategoryIds)
                {
                    <input type="hidden" name="categoryIds" value="@id" />
                }
            </div>
            <input type="hidden" name="sort" value="@Model.Sort" id="sortInput" />
            <input type="hidden" name="page" value="1" />

            <span class="chips-label">Thể loại:</span>

            <button type="button"
                    class="chip @(!Model.SelectedCategoryIds.Any() ? "active" : "")"
                    onclick="clearCategories()">
                Tất cả
            </button>

            @foreach (var cat in Model.Categories)
            {
                bool isActive = Model.SelectedCategoryIds.Contains(cat.CategoryId);
                <button type="button"
                        class="chip @(isActive ? "active" : "")"
                        onclick="toggleCategory(@cat.CategoryId)">
                    @cat.CategoryName
                    @if (isActive)
                    {
                        <i class="fas fa-times ms-1" style="font-size:10px;"></i>
                    }
                </button>
            }

            @if (Model.SelectedCategoryIds.Any())
            {
                <button type="button" class="chip-clear" onclick="clearCategories()">
                    <i class="fas fa-times me-1"></i>Xoá bộ lọc (@Model.SelectedCategoryIds.Count)
                </button>
            }
        </div>
    </div>
</section>

<!-- ══ CONTENT ═══════════════════════════════════════════════════════════ -->
<div class="container" style="padding-top:24px; padding-bottom:48px;">

    <!-- AI badge -->
    @if (Model.IsAiSearch)
    {
        <div class="alert alert-primary d-flex align-items-center mb-3 py-2" role="alert">
            <i class="fas fa-robot me-2"></i>
            <div>
                <strong>AI hiểu:</strong> @Model.AiInterpretedQuery
                <span class="ms-2 text-muted small">(từ khóa: "<em>@Model.Keyword</em>")</span>
            </div>
        </div>
    }

    <!-- Error -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Toolbar: đếm kết quả + sort -->
    <div class="cat-toolbar">
        <p class="cat-count">
            @{
                int fromItem = Model.TotalCount == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1;
                int toItem   = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
            }
            Hiển thị <strong>@fromItem&ndash;@toItem</strong>
            trên <strong>@Model.TotalCount</strong> đầu sách
            @if (Model.SelectedCategoryIds.Any())
            {
                var names = Model.Categories
                    .Where(c => Model.SelectedCategoryIds.Contains(c.CategoryId))
                    .Select(c => c.CategoryName);
                <span class="ms-1" style="color:var(--c-accent);">&bull; @string.Join(", ", names)</span>
            }
        </p>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted" style="font-size:13px;">Sắp xếp:</span>
            <select class="cat-sort-select" onchange="changeSort(this.value)">
                @if (Model.Sort == "newest")
                {
                    <option value="newest" selected>Mới nhất</option>
                    <option value="oldest">Cũ nhất</option>
                }
                else
                {
                    <option value="newest">Mới nhất</option>
                    <option value="oldest" selected>Cũ nhất</option>
                }
            </select>
        </div>
    </div>

    <!-- Book grid -->
    @if (!Model.Books.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-book-open fa-3x mb-3 d-block"></i>
            @if (Model.IsAiSearch)
            {
                <p>AI không tìm thấy sách phù hợp với "<strong>@Model.OriginalAiQuery</strong>". Thử diễn đạt khác nhé!</p>
            }
            else if (!string.IsNullOrWhiteSpace(Model.Keyword))
            {
                <p>Không tìm thấy sách phù hợp với từ khoá "<strong>@Model.Keyword</strong>".</p>
            }
            else
            {
                <p>Không có sách nào trong danh mục này.</p>
            }
        </div>
    }
    else
    {
        <div class="cat-grid">
            @foreach (var book in Model.Books)
            {
                bool   isAvailable = book.Status == "Có thể mượn";
                string statusClass = isAvailable ? "status-available" : "status-borrowed";
                string statusLabel = isAvailable ? "Sẵn có" : "Đang mượn";
                string catName     = book.BookCategories.FirstOrDefault()?.Category?.CategoryName ?? "";

                <div class="cat-card">
                    <!-- Cover -->
                    <div class="cat-cover">
                        @if (!string.IsNullOrWhiteSpace(book.ImageUrl))
                        {
                            <img src="@book.ImageUrl" alt="@book.Title"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                            <div class="cat-no-img" style="display:none;">
                                <i class="fas fa-book fa-2x text-muted"></i>
                            </div>
                        }
                        else
                        {
                            <div class="cat-no-img">
                                <i class="fas fa-book fa-2x text-muted"></i>
                            </div>
                        }
                        <span class="cat-status-badge @statusClass">@statusLabel</span>
                    </div>

                    <!-- Body -->
                    <div class="cat-body">
                        @if (!string.IsNullOrWhiteSpace(catName))
                        {
                            <div class="cat-cat-label">@catName</div>
                        }
                        <h3 class="cat-title" title="@book.Title">@book.Title</h3>
                        <p class="cat-meta">
                            @(book.Author ?? "—")
                            @if (book.PublishYear.HasValue)
                            {
                                <text>&nbsp;&bull;&nbsp;@book.PublishYear</text>
                            }
                        </p>

                        @if (isAvailable)
                        {
                            <a asp-controller="Search" asp-action="Details"
                               asp-route-id="@book.BookId"
                               class="cat-btn-detail btn-available">
                                <i class="fas fa-eye me-1"></i>Chi tiết
                            </a>
                        }
                        else
                        {
                            <span class="cat-btn-detail btn-unavailable">Không khả dụng</span>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="cat-pagination mt-4">

            @* Prev *@
            @if (Model.HasPrev)
            {
                <a href="@PageUrl(Model.CurrentPage - 1)" class="pag-btn">
                    <i class="fas fa-chevron-left"></i>
                </a>
            }
            else
            {
                <span class="pag-btn disabled"><i class="fas fa-chevron-left"></i></span>
            }

            @{
                int pStart = Math.Max(1, Model.CurrentPage - 2);
                int pEnd   = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
            }

            @if (pStart > 1)
            {
                <a href="@PageUrl(1)" class="pag-btn">1</a>
                if (pStart > 2)
                {
                    <span class="pag-btn disabled" style="border:none;">…</span>
                }
            }

            @for (int p = pStart; p <= pEnd; p++)
            {
                <a href="@PageUrl(p)"
                   class="pag-btn @(p == Model.CurrentPage ? "active" : "")">@p</a>
            }

            @if (pEnd < Model.TotalPages)
            {
                if (pEnd < Model.TotalPages - 1)
                {
                    <span class="pag-btn disabled" style="border:none;">…</span>
                }
                <a href="@PageUrl(Model.TotalPages)" class="pag-btn">@Model.TotalPages</a>
            }

            @* Next *@
            @if (Model.HasNext)
            {
                <a href="@PageUrl(Model.CurrentPage + 1)" class="pag-btn">
                    <i class="fas fa-chevron-right"></i>
                </a>
            }
            else
            {
                <span class="pag-btn disabled"><i class="fas fa-chevron-right"></i></span>
            }

        </nav>
    }

</div>

<style>
/* ── Dùng lại CSS variables đã có trong Home/Index ───────────── */
/* (--c-bg, --c-accent, --c-text, --c-muted, --c-border đã khai báo trong Home) */

/* ── Hero ─────────────────────────────────────────────────────── */
.cat-hero {
    background: #fff;
    border-bottom: 1px solid var(--c-border, #e5e7ef);
    padding: 36px 0 24px;
}
.cat-eyebrow {
    font-size: .78rem; letter-spacing: .14em; text-transform: uppercase;
    color: var(--c-accent, #3b7ef8); margin-bottom: 8px; font-weight: 600;
}
.cat-heading {
    font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 800;
    color: var(--c-text, #1a1d2e); margin: 0 0 8px;
}
.cat-sub {
    color: var(--c-muted, #6b7280); font-size: .95rem; margin: 0 0 24px;
}

/* ── Search box (kế thừa style hero từ Home) ─────────────────── */
.cat-search-box {
    background: #fff;
    border: 1px solid var(--c-border, #e5e7ef);
    border-radius: 16px;
    padding: 18px 20px;
    max-width: 660px;
    box-shadow: 0 6px 24px rgba(59,126,248,.08);
}
.search-tabs { display: flex; gap: 8px; }
.stab {
    padding: 6px 14px; border-radius: 10px;
    border: 1px solid var(--c-border, #e5e7ef);
    background: var(--c-bg2, #f5f7fb);
    color: var(--c-muted, #6b7280); font-size: .86rem;
    cursor: pointer; transition: all .2s;
    display: flex; align-items: center; gap: 6px;
}
.stab.active {
    background: var(--c-accent, #3b7ef8);
    color: #fff; border-color: var(--c-accent, #3b7ef8);
}
.badge-beta {
    background: rgba(59,126,248,.12);
    color: var(--c-accent, #3b7ef8);
    border-radius: 6px; padding: 1px 7px;
    font-size: .7rem; font-weight: 700;
}
.cat-search-form {
    display: flex; align-items: center; gap: 10px;
    background: var(--c-bg2, #f5f7fb);
    border-radius: 10px; padding: 6px 6px 6px 14px;
    border: 1px solid var(--c-border, #e5e7ef);
    margin-top: 14px;
}
.search-ico-inside { color: var(--c-muted, #9ca3af); flex-shrink: 0; }
.cat-search-input {
    flex: 1; background: transparent; border: none;
    outline: none; font-size: .93rem;
    color: var(--c-text, #1a1d2e);
}
.cat-search-input::placeholder { color: #adb5bd; }
.cat-search-btn {
    background: var(--c-accent, #3b7ef8); color: #fff;
    border: none; border-radius: 8px; padding: 8px 20px;
    font-size: .88rem; font-weight: 600; cursor: pointer;
    white-space: nowrap; transition: opacity .2s;
}
.cat-search-btn:hover { opacity: .88; }
.ai-btn { background: linear-gradient(135deg,var(--c-accent,#3b7ef8),var(--c-accent2,#6c5ce7)); }

/* ── Category chips ───────────────────────────────────────────── */
.chips-row {
    display: flex; flex-wrap: wrap;
    gap: 8px; align-items: center;
}
.chips-label {
    font-size: .8rem; color: var(--c-muted,#6b7280);
    font-style: italic; margin-right: 2px;
}
.chip {
    padding: 5px 14px; border-radius: 20px; font-size: .82rem;
    cursor: pointer; border: 1.5px solid var(--c-border, #d1d5db);
    background: #fff; color: var(--c-muted, #4b5563);
    transition: all .18s; user-select: none;
}
.chip:hover {
    border-color: var(--c-accent, #3b7ef8);
    color: var(--c-accent, #3b7ef8);
}
.chip.active {
    background: var(--c-accent, #3b7ef8); color: #fff;
    border-color: var(--c-accent, #3b7ef8); font-weight: 600;
    box-shadow: 0 2px 8px rgba(59,126,248,.2);
}
.chip-clear {
    padding: 5px 14px; border-radius: 20px; font-size: .78rem;
    cursor: pointer; background: #fef2f2; color: #dc2626;
    border: 1.5px solid #fecaca; font-weight: 500;
    transition: all .18s;
}
.chip-clear:hover { background: #fee2e2; }

/* ── Toolbar ──────────────────────────────────────────────────── */
.cat-toolbar {
    display: flex; justify-content: space-between;
    align-items: center; margin-bottom: 20px;
}
.cat-count { font-size: .88rem; color: var(--c-muted, #6b7280); margin: 0; }
.cat-count strong { color: var(--c-text, #1a1d2e); }
.cat-sort-select {
    padding: 6px 12px;
    border: 1px solid var(--c-border, #d1d5db);
    border-radius: 8px; font-size: .85rem;
    background: #fff; color: var(--c-text, #374151);
    cursor: pointer; outline: none;
}

/* ── Book grid ────────────────────────────────────────────────── */
.cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px; margin-bottom: 8px;
}

/* ── Book card ────────────────────────────────────────────────── */
.cat-card {
    background: #fff;
    border-radius: 14px;
    border: 1px solid var(--c-border, #e5e7ef);
    overflow: hidden;
    transition: transform .2s, box-shadow .2s;
    box-shadow: 0 2px 8px rgba(0,0,0,.05);
}
.cat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(59,126,248,.12);
    border-color: var(--c-accent, #3b7ef8);
}
.cat-cover {
    position: relative; height: 190px;
    overflow: hidden; background: var(--c-bg2, #f5f7fb);
}
.cat-cover img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .3s; display: block;
}
.cat-card:hover .cat-cover img { transform: scale(1.04); }
.cat-no-img {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
}
.cat-status-badge {
    position: absolute; top: 10px; left: 10px;
    font-size: .68rem; font-weight: 700;
    padding: 3px 10px; border-radius: 20px; letter-spacing: .3px;
}
.status-available { background: #dcfce7; color: #16a34a; }
.status-borrowed  { background: #fef3c7; color: #d97706; }

.cat-body { padding: 12px 14px 14px; }
.cat-cat-label {
    font-size: .68rem; font-weight: 700;
    color: var(--c-accent, #3b7ef8);
    text-transform: uppercase; letter-spacing: .8px; margin-bottom: 5px;
}
.cat-title {
    font-size: .88rem; font-weight: 700;
    color: var(--c-text, #111827);
    margin: 0 0 4px; line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
}
.cat-meta { font-size: .76rem; color: var(--c-muted, #9ca3af); margin: 0 0 12px; }
.cat-btn-detail {
    display: block; width: 100%; padding: 8px 0;
    text-align: center; border-radius: 8px;
    font-size: .83rem; font-weight: 600;
    text-decoration: none; border: none; cursor: pointer;
    transition: opacity .18s;
}
.btn-available {
    background: var(--c-accent, #3b7ef8); color: #fff;
}
.btn-available:hover { opacity: .88; color: #fff; }
.btn-unavailable {
    background: var(--c-bg2, #f3f4f6);
    color: var(--c-muted, #9ca3af); pointer-events: none;
}

/* ── Pagination ───────────────────────────────────────────────── */
.cat-pagination {
    display: flex; justify-content: center;
    align-items: center; gap: 6px;
}
.pag-btn {
    min-width: 36px; height: 36px; border-radius: 8px;
    font-size: .88rem; padding: 0 10px;
    border: 1px solid var(--c-border, #d1d5db);
    background: #fff; color: var(--c-text, #374151);
    cursor: pointer; text-decoration: none;
    display: inline-flex; align-items: center; justify-content: center;
    transition: all .15s;
}
.pag-btn:hover:not(.disabled):not(.active) {
    border-color: var(--c-accent, #3b7ef8);
    color: var(--c-accent, #3b7ef8);
}
.pag-btn.active {
    background: var(--c-accent, #3b7ef8); color: #fff;
    border-color: var(--c-accent, #3b7ef8); font-weight: 700;
}
.pag-btn.disabled {
    color: #d1d5db; cursor: default; background: #f9fafb;
}
</style>

@section Scripts {
<script>
    // Khởi tạo state từ server
    let selectedCats = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(Model.SelectedCategoryIds));

    function toggleCategory(id) {
        selectedCats = selectedCats.includes(id)
            ? selectedCats.filter(x => x !== id)
            : [...selectedCats, id];
        submitFilter();
    }

    function clearCategories() {
        selectedCats = [];
        submitFilter();
    }

    function changeSort(value) {
        document.getElementById('sortInput').value = value;
        submitFilter();
    }

    function submitFilter() {
        // Cập nhật hidden inputs danh mục trong filterForm
        document.getElementById('catInputs').innerHTML =
            selectedCats.map(id =>
                `<input type="hidden" name="categoryIds" value="${id}">`
            ).join('');
        // Reset page về 1
        document.querySelector('#filterForm input[name="page"]').value = 1;

        // Dùng form tìm kiếm thường (GET) để submit filter
        // — xây URL thủ công để tránh conflit với 2 form trên trang
        const keyword = document.querySelector('input[name="keyword"]')?.value ?? '';
        const sort    = document.getElementById('sortInput').value;

        let url = '@Url.Action("Index", "Search")?page=1';
        if (keyword) url += `&keyword=${encodeURIComponent(keyword)}`;
        selectedCats.forEach(id => { url += `&categoryIds=${id}`; });
        if (sort !== 'newest') url += `&sort=${sort}`;

        window.location.href = url;
    }

    function switchTab(tab) {
        const isAi = tab === 'ai';
        document.getElementById('tab-normal').classList.toggle('active', !isAi);
        document.getElementById('tab-ai').classList.toggle('active', isAi);
        document.getElementById('form-normal').classList.toggle('d-none', isAi);
        document.getElementById('form-ai').classList.toggle('d-none', !isAi);
    }
</script>
}
