@model Client.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Đăng Ký Bạn Đọc";
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-user-plus me-2"></i> Đăng Ký Tài Khoản Bạn Đọc
                    </h3>
                </div>

                <div class="card-body p-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <strong>Lỗi!</strong> Vui lòng kiểm tra lại thông tin.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Register" asp-controller="Account" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Email (Bắt Buộc) -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Email" class="form-label fw-semibold @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "text-danger" : "")">
                                        <i class="fas fa-envelope me-2 text-primary"></i>Email <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Email" type="email" class="form-control form-control-lg @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")" 
                                           placeholder="example@email.com">
                                    <span asp-validation-for="Email" class="text-danger small d-block"></span>
                                    @if (ViewData.ModelState["Email"]?.Errors.Any() ?? false)
                                    {
                                        <small class="text-danger fw-bold d-block mt-1">
                                            <i class="fas fa-times-circle me-1"></i>
                                            @ViewData.ModelState["Email"]?.Errors.First().ErrorMessage
                                        </small>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="FullName" class="form-label fw-semibold">
                                        <i class="fas fa-user me-2 text-primary"></i>Họ và Tên <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="FullName" type="text" class="form-control form-control-lg" 
                                           placeholder="Nguyễn Văn A">
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Số Điện Thoại + Giới Tính -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Phone" class="form-label fw-semibold">
                                        <i class="fas fa-phone me-2 text-primary"></i>Số Điện Thoại
                                    </label>
                                    <input asp-for="Phone" type="text" class="form-control form-control-lg"
                                           placeholder="0xxxxxxxxx">
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Gender" class="form-label fw-semibold">
                                        <i class="fas fa-venus-mars me-2 text-primary"></i>Giới Tính
                                    </label>
                                    <select asp-for="Gender" class="form-select form-select-lg">
                                        <option value="Nam">Nam</option>
                                        <option value="Nữ">Nữ</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Mật Khẩu -->
                        <div class="mb-4">
                            <div class="form-group">
                                <label asp-for="Password" class="form-label fw-semibold">
                                    <i class="fas fa-lock me-2 text-primary"></i>Mật Khẩu <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="Password" id="registerPassword" type="password" 
                                           class="form-control form-control-lg" 
                                           placeholder="Nhập mật khẩu (tối thiểu 6 ký tự)">
                                    <button type="button" class="btn btn-outline-secondary" 
                                            onclick="toggleRegisterPassword()">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                                <div class="form-check mt-2">
                                    <input type="checkbox" class="form-check-input" id="showPassword" 
                                           onchange="toggleRegisterPassword()">
                                    <label class="form-check-label" for="showPassword">
                                        <i class="fas fa-eye me-1"></i>Hiển thị mật khẩu
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Ngày Sinh + Giới Tính -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="DoB" class="form-label fw-semibold">
                                        <i class="fas fa-calendar me-2 text-primary"></i>Ngày Sinh
                                    </label>
                                    <input asp-for="DoB" type="date" class="form-control form-control-lg">
                                    <span asp-validation-for="DoB" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Gender" class="form-label fw-semibold">
                                        <i class="fas fa-venus-mars me-2 text-primary"></i>Giới Tính
                                    </label>
                                    <select asp-for="Gender" class="form-select form-select-lg">
                                        <option value="Nam">Nam</option>
                                        <option value="Nữ">Nữ</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Địa Chỉ -->
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="Address" class="form-label fw-semibold">
                                        <i class="fas fa-map-marker-alt me-2 text-primary"></i>Địa Chỉ
                                    </label>
                                    <input asp-for="Address" type="text" class="form-control form-control-lg" 
                                           placeholder="123 Đường Lý Thái Tông, Quận Hà Nội">
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Ảnh Đại Diện -->
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="AvatarFile" class="form-label fw-semibold">
                                        <i class="fas fa-image me-2 text-primary"></i>Ảnh Đại Diện
                                    </label>
                                    <div class="input-group">
                                        <input asp-for="AvatarFile" type="file" class="form-control form-control-lg" 
                                               accept="image/*" id="avatarInput">
                                    </div>
                                    <small class="text-muted d-block mt-1">Định dạng: JPG, PNG, GIF (tối đa 5MB)</small>
                                    <div id="avatarPreview" class="mt-3" style="display: none;">
                                        <img id="previewImg" src="" alt="Avatar preview" 
                                             style="max-width: 150px; height: 150px; object-fit: cover; border-radius: 8px;">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Alert: Điều Khoản & Điều Kiện -->
                        <div class="alert alert-info mb-4" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Lưu ý:</strong> Sau khi đăng ký thành công, bạn sẽ nhận được mã bạn đọc dùng để mượn sách.
                        </div>

                        <!-- Nút Hành Động -->
                        <div class="d-flex gap-3 justify-content-between mt-5">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times me-2"></i> Hủy
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-check me-2"></i> Đăng Ký
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Link Đăng Nhập -->
            <div class="text-center mt-4">
                <p class="text-muted">
                    Đã có tài khoản? 
                    <a href="@Url.Action("Login", "Account")" class="text-primary fw-bold">
                        Đăng nhập tại đây
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control-lg, .form-select-lg {
        min-height: 50px;
        font-size: 1rem;
    }

    .form-label {
        margin-bottom: 0.75rem;
    }

    .card {
        border: none;
        border-radius: 12px;
        overflow: hidden;
    }

    .card-header {
        border-bottom: 3px solid #0056b3;
    }

    .btn-lg {
        padding: 12px 32px;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .text-danger {
        font-weight: 600;
    }

    .text-primary {
        color: #0056b3 !important;
    }
</style>

@section Scripts {
    <!-- Toggle Password Visibility Script -->
    <script>
        function toggleRegisterPassword() {
            const input = document.getElementById('registerPassword');
            const checkbox = document.getElementById('showPassword');
            const button = document.querySelector('button[onclick="toggleRegisterPassword()"]');
            const icon = button.querySelector('i');

            if (checkbox.checked) {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>

    <!-- Avatar Preview Script -->
    <script>
        document.getElementById('avatarInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    document.getElementById('previewImg').src = event.target.result;
                    document.getElementById('avatarPreview').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });
    </script>

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
