@model Client.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân";
}

<div class="container mt-4 mb-5">

    <!-- ── CARD HEADER: Avatar + Tên + Mã + Nút sửa ── -->
    <div class="profile-header-card mb-4">
        <div class="d-flex align-items-center gap-4 flex-wrap">

            <!-- Avatar -->
            <div class="avatar-wrapper position-relative">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" class="avatar-img"
                         onerror="this.style.display='none';document.getElementById('avatarFallback').style.display='flex'" />
                    <div id="avatarFallback" class="avatar-fallback" style="display:none">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                }
                else
                {
                    <div id="avatarFallback" class="avatar-fallback">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                }
                <a href="@Url.Action("EditProfile", "Account")" class="avatar-edit-btn" title="Chỉnh sửa">
                    <i class="fas fa-pen"></i>
                </a>
            </div>

            <!-- Thông tin chính -->
            <div class="flex-grow-1">
                <h4 class="mb-1 fw-bold">@Model.FullName</h4>
                <div class="d-flex flex-wrap gap-3 text-muted small mb-1">
                    <span><i class="fas fa-id-card me-1"></i>@Model.ReaderId</span>
                    @if (!string.IsNullOrEmpty(Model.Gender))
                    {
                        <span><i class="fas fa-venus-mars me-1"></i>@Model.Gender</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        <span><i class="fas fa-map-marker-alt me-1"></i>@Model.Address</span>
                    }
                </div>
                <div class="text-muted small">
                    <i class="fas fa-calendar-alt me-1"></i>
                    Thành viên từ: @(Model.CreatedAt?.ToString("dd/MM/yyyy") ?? "—")
                </div>
            </div>

            <!-- Badge + Nút -->
            <div class="d-flex flex-column align-items-end gap-2">
                <span class="badge-active">
                    <i class="fas fa-circle me-1" style="font-size:8px;vertical-align:middle"></i>
                    Độc giả tích cực
                </span>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("EditProfile", "Account")" class="btn btn-primary btn-sm">
                        <i class="fas fa-edit me-1"></i> Chỉnh sửa
                    </a>
                    <a href="@Url.Action("DeleteAccount", "Account")" class="btn btn-outline-danger btn-sm">
                        <i class="fas fa-trash me-1"></i> Xóa tài khoản
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ── TABS ── -->
    <ul class="nav profile-tabs mb-4" id="profileTabs">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#tab-info">
                <i class="fas fa-user me-1"></i> Thông tin cá nhân
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="@Url.Action("BorrowHistory", "Borrow")">
                <i class="fas fa-history me-1"></i> Lịch sử mượn sách
            </a>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="tab-info">
            <div class="row g-4">

                <!-- Thông tin liên lạc -->
                <div class="col-12">
                    <div class="info-card">
                        <div class="info-card-title">
                            <span class="info-card-bar"></span> Thông tin liên lạc
                        </div>
                        <div class="row g-4 mt-1">
                            <div class="col-md-3 col-6">
                                <div class="info-field-label">EMAIL</div>
                                <div class="info-field-value">
                                    @if (!string.IsNullOrEmpty(Model.Email))
                                    {
                                        @Model.Email
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="info-field-label">SỐ ĐIỆN THOẠI</div>
                                <div class="info-field-value">
                                    @if (!string.IsNullOrEmpty(Model.Phone))
                                    {
                                        @* Hiển thị số kiểu ẩn: 0908 ••• •89 *@
                                        @(Model.Phone.Length >= 4
                                            ? Model.Phone.Substring(0, 4) + " ••• •" + Model.Phone.Substring(Model.Phone.Length - 2)
                                            : Model.Phone)
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="info-field-label">MẬT KHẨU</div>
                                <div class="info-field-value d-flex gap-2 align-items-center">
                                    <input type="password" id="reader-password" value="••••••••" readonly 
                                        style="flex: 1; padding: 6px; border: 1px solid #ddd; border-radius: 4px; background: #f9f9f9; font-family: monospace;" />
                                    <button type="button" id="toggle-password-btn" class="btn btn-sm btn-outline-secondary" 
                                        style="padding: 6px 10px; cursor: pointer; border: 1px solid #ddd; border-radius: 4px;" title="Hiện/Ẩn mật khẩu">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="info-field-label">NGÀY SINH</div>
                                <div class="info-field-value">
                                    @(Model.DoB?.ToString("dd/MM/yyyy") ?? "—")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Thống kê -->
                <div class="col-12">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-blue">
                                <div class="stat-number">@Model.TotalBorrow</div>
                                <div class="stat-label">SÁCH ĐÃ MƯỢN</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-green">
                                <div class="stat-number">@Model.BorrowingCount</div>
                                <div class="stat-label">ĐANG MƯỢN</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-orange">
                                <div class="stat-number">@Model.OverdueCount</div>
                                <div class="stat-label">QUÁ HẠN</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-purple">
                                <div class="stat-number">@Model.ReturnedCount</div>
                                <div class="stat-label">ĐÃ TRẢ</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    /* ── Header card ── */
    .profile-header-card {
        background: #fff;
        border-radius: 16px;
        padding: 28px 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,.08);
    }

    /* ── Avatar ── */
    .avatar-wrapper { position: relative; flex-shrink: 0; }

    .avatar-img, .avatar-fallback {
        width: 90px; height: 90px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #e8edf3;
    }

    .avatar-fallback {
        background: #0d6efd;
        color: #fff;
        font-size: 36px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .avatar-edit-btn {
        position: absolute;
        bottom: 2px; right: 2px;
        width: 26px; height: 26px;
        background: #0d6efd;
        border-radius: 50%;
        color: #fff;
        font-size: 11px;
        display: flex; align-items: center; justify-content: center;
        text-decoration: none;
        box-shadow: 0 1px 4px rgba(0,0,0,.2);
    }

    .avatar-edit-btn:hover { background: #0b5ed7; color: #fff; }

    /* ── Badge active ── */
    .badge-active {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    /* ── Tabs ── */
    .profile-tabs {
        border-bottom: 2px solid #e9ecef;
        gap: 4px;
    }

    .profile-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        padding: 10px 20px;
        border: none;
        border-bottom: 3px solid transparent;
        border-radius: 0;
        margin-bottom: -2px;
        transition: all .2s;
    }

    .profile-tabs .nav-link:hover { color: #0d6efd; }

    .profile-tabs .nav-link.active {
        color: #0d6efd;
        border-bottom-color: #0d6efd;
        background: transparent;
    }

    /* ── Info card ── */
    .info-card {
        background: #fff;
        border-radius: 12px;
        padding: 24px 28px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }

    .info-card-title {
        font-weight: 700;
        font-size: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 4px;
    }

    .info-card-bar {
        display: inline-block;
        width: 4px; height: 20px;
        background: #0d6efd;
        border-radius: 2px;
    }

    .info-field-label {
        font-size: 11px;
        font-weight: 700;
        color: #9ba4b0;
        letter-spacing: .5px;
        margin-bottom: 4px;
    }

    .info-field-value {
        font-size: 15px;
        color: #212529;
        font-weight: 500;
    }

    /* ── Stat cards ── */
    .stat-card {
        border-radius: 12px;
        padding: 20px 16px;
        text-align: center;
    }

    .stat-number {
        font-size: 32px;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 6px;
    }

    .stat-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
    }

    .stat-blue   { background: #e8f0fe; color: #1a56db; }
    .stat-green  { background: #e8f5e9; color: #2e7d32; }
    .stat-orange { background: #fff3e0; color: #e65100; }
    .stat-purple { background: #f3e5f5; color: #6a1b9a; }

    .stat-blue .stat-label   { color: #1a56db; opacity: .7; }
    .stat-green .stat-label  { color: #2e7d32; opacity: .7; }
    .stat-orange .stat-label { color: #e65100; opacity: .7; }
    .stat-purple .stat-label { color: #6a1b9a; opacity: .7; }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const readerId = '@Model.ReaderId';
        const passwordInput = document.getElementById("reader-password");
        const toggleBtn = document.getElementById("toggle-password-btn");

        if (toggleBtn) {
            toggleBtn.addEventListener("click", function() {
                if (passwordInput.type === "password") {
                    passwordInput.type = "text";
                    toggleBtn.innerHTML = '<i class="fas fa-eye-slash"></i>';
                } else {
                    passwordInput.type = "password";
                    toggleBtn.innerHTML = '<i class="fas fa-eye"></i>';
                }
            });
        }

        // Lấy mật khẩu từ API
        fetch(`/api/auth/password/${encodeURIComponent(readerId)}`)
            .then(response => {
                if (response.ok) {
                    return response.json();
                } else if (response.status === 401) {
                    throw new Error("Không có quyền");
                } else {
                    throw new Error("Không tìm thấy");
                }
            })
            .then(data => {
                if (passwordInput && data.password) {
                    passwordInput.value = data.password;
                    passwordInput.type = "password"; // Mặc định ẩn
                }
            })
            .catch(error => {
                console.error("Lỗi khi lấy mật khẩu:", error);
                if (passwordInput) {
                    passwordInput.value = "Không thể tải";
                    passwordInput.disabled = true;
                }
                if (toggleBtn) {
                    toggleBtn.style.display = "none";
                }
            });
    });
</script>
