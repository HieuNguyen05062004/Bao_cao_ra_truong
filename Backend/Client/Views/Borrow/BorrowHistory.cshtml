@model List<Core.Shared.Entities.BorrowTicket>

@{
    ViewData["Title"] = "Lịch Sử Mượn Sách";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-history me-2"></i> Lịch Sử Mượn Sách
                    </h4>
                </div>

                <div class="card-body p-4">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead class="table-primary">
                                    <tr>
                                        <th width="10%">Mã Yêu Cầu</th>
                                        <th width="20%">Ngày Mượn</th>
                                        <th width="20%">Ngày Trả Dự Kiến</th>
                                        <th width="15%">Trạng Thái</th>
                                        <th width="15%">Số Sách</th>
                                        <th width="20%">Hành Động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ticket in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>#@ticket.TicketId</strong>
                                            </td>
                                            <td>
                                                @ticket.BorrowDate?.ToString("dd/MM/yyyy HH:mm")
                                            </td>
                                            <td>
                                                @ticket.DueDate?.ToString("dd/MM/yyyy")
                                            </td>
                                            <td>
                                                @{
                                                    var statusBadgeClass = ticket.Status switch
                                                    {
                                                        "Pending" => "badge bg-warning text-dark",
                                                        "Approved" => "badge bg-success",
                                                        "Returned" => "badge bg-info",
                                                        "Rejected" => "badge bg-danger",
                                                        _ => "badge bg-secondary"
                                                    };

                                                    var statusText = ticket.Status switch
                                                    {
                                                        "Pending" => "Chờ Duyệt",
                                                        "Approved" => "Đã Duyệt",
                                                        "Returned" => "Đã Trả",
                                                        "Rejected" => "Bị Từ Chối",
                                                        _ => ticket.Status
                                                    };
                                                }
                                                <span class="@statusBadgeClass">@statusText</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary">@ticket.Books.Count</span>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("BorrowDetail", "Borrow", new { ticketId = ticket.TicketId })"
                                                   class="btn btn-sm btn-info">
                                                    <i class="fas fa-eye me-1"></i> Chi Tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Bạn chưa có yêu cầu mượn sách nào.</strong>
                        </div>
                    }

                    <div class="mt-4">
                        <a href="@Url.Action("Index", "Search")" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i> Mượn Sách Mới
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .badge {
        padding: 8px 12px;
        font-size: 0.95rem;
    }

    .btn-sm {
        padding: 6px 12px;
        font-size: 0.9rem;
    }
</style>
