@model Core.Shared.Entities.BorrowTicket
@{
    ViewData["Title"] = $"Phiếu Mượn #{Model.TicketId}";
    var isOverdue = Model.DueDate.HasValue
                   && Model.DueDate < DateTime.Now
                   && Model.Status != "Đã trả"
                   && Model.Status != "Bị từ chối";
}

@functions {
    static (string bg, string text, string icon) StatusStyle(string? status) => status switch
    {
        "Chờ duyệt" => ("warning", "dark", "bi-hourglass-split"),
        "Đã duyệt" => ("info", "dark", "bi-check-circle"),
        "Đang mượn" => ("primary", "white", "bi-book-half"),
        "Đã trả" => ("success", "white", "bi-archive"),
        "Bị từ chối" => ("danger", "white", "bi-x-circle"),
        _ => ("secondary", "white", "bi-question-circle")
    };
}

@{
    var (bgColor, txtColor, statusIcon) = StatusStyle(Model.Status);
}

<div class="container mt-5" style="max-width:860px">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-lg mb-4">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0">
                <i class="bi bi-journal-bookmark me-2"></i>
                Chi Tiết Phiếu Mượn <strong>#@Model.TicketId</strong>
            </h5>
            <div class="d-flex gap-2 flex-wrap justify-content-end">
                <span class="badge bg-@bgColor text-@txtColor fs-6 px-3 py-2">
                    <i class="bi @statusIcon me-1"></i>@Model.Status
                </span>
                @if (isOverdue)
                {
                    <span class="badge bg-danger fs-6 px-3 py-2">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Quá hạn
                    </span>
                }
            </div>
        </div>

        <div class="card-body p-4">

            @* ── Thông tin phiếu ── *@
            <div class="row mb-4">
                <div class="col-md-6">
                    <p class="mb-2">
                        <span class="text-muted">Ngày mượn:</span><br />
                        <strong>@Model.BorrowDate?.ToString("dd/MM/yyyy HH:mm")</strong>
                    </p>
                    <p class="mb-2">
                        <span class="text-muted">Hạn trả dự kiến:</span><br />
                        <strong>@Model.DueDate?.ToString("dd/MM/yyyy")</strong>
                    </p>
                    @if (Model.ReturnDate.HasValue)
                    {
                        <p class="mb-2">
                            <span class="text-muted">Ngày trả thực tế:</span><br />
                            <strong class="text-success">
                                @Model.ReturnDate.Value.ToString("dd/MM/yyyy HH:mm")
                            </strong>
                        </p>
                    }
                </div>
                <div class="col-md-6">
                    <p class="mb-2">
                        <span class="text-muted">Bạn đọc:</span><br />
                        <strong>@(Model.Reader?.FullName ?? Model.ReaderId)</strong>
                    </p>
                    @if (!string.IsNullOrEmpty(Model.StaffUsername))
                    {
                        <p class="mb-2">
                            <span class="text-muted">Nhân viên xử lý:</span><br />
                            <strong>@(Model.StaffUsernameNavigation?.FullName ?? Model.StaffUsername)</strong>
                        </p>
                    }
                </div>
            </div>

            <hr />

            @* ── Danh sách sách ── *@
            <h6 class="fw-bold mb-3">
                <i class="bi bi-book me-2 text-primary"></i>
                Sách Mượn <span class="badge bg-primary">@Model.Books.Count</span>
            </h6>

            @if (Model.Books.Any())
            {
                <div class="row g-3">
                    @foreach (var book in Model.Books)
                    {
                        <div class="col-md-6">
                            <div class="card border h-100">
                                <div class="row g-0 h-100">
                                    <div class="col-4 d-flex align-items-center justify-content-center
                                        bg-light rounded-start" style="min-height:110px">
                                        @if (!string.IsNullOrEmpty(book.ImageUrl))
                                        {
                                            <img src="@book.ImageUrl" alt="@book.Title"
                                                 class="img-fluid rounded-start"
                                                 style="max-height:110px;object-fit:cover" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-book fa-2x text-muted fs-1"></i>
                                        }
                                    </div>
                                    <div class="col-8">
                                        <div class="card-body py-2 px-3">
                                            <p class="fw-bold mb-1 text-truncate" title="@book.Title">
                                                @book.Title
                                            </p>
                                            <p class="text-muted small mb-1">
                                                @(book.Author ?? "Không rõ tác giả")
                                            </p>
                                            <p class="text-muted small mb-0">
                                                @(book.Publisher ?? "")
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">Không có sách trong phiếu này.</p>
            }
        </div>

        <div class="card-footer bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="BorrowHistory" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại lịch sử
                </a>
                <button class="btn btn-outline-primary btn-sm" onclick="location.reload()">
                    <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
                </button>
            </div>
        </div>
    </div>

    @* Thông báo giúp client biết status có thể đã được admin cập nhật *@
    @if (Model.Status == "Chờ duyệt" || Model.Status == "Đã duyệt")
    {
        <div class="alert alert-info alert-dismissible fade show mt-4">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Lưu ý:</strong> 
            @if (Model.Status == "Chờ duyệt")
            {
                <span>Phiếu đang chờ duyệt. Admin sẽ sớm xử lý. Nhấn <strong>"Làm mới"</strong> để cập nhật trạng thái.</span>
            }
            else if (Model.Status == "Đã duyệt")
            {
                <span>Phiếu đã được duyệt. Admin sẽ giao sách cho bạn. Nhấn <strong>"Làm mới"</strong> để cập nhật trạng thái.</span>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
</div>

