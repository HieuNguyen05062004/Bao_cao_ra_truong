@model List<Core.Shared.Entities.Book>
@using Core.Shared.Entities
@{
    ViewData["Title"] = "Danh Sách Sách";
    var categories  = ViewBag.Categories as List<Category> ?? new();
    var categoryId  = (int)ViewBag.CategoryId;
    var keyword     = ViewBag.Keyword as string ?? "";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages  = (int)ViewBag.TotalPages;
    var totalCount  = (int)ViewBag.TotalCount;
}

<div class="container py-4">

    @* ── Thông báo ── *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── Tiêu đề ── *@
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-book me-2 text-primary"></i>Danh Sách Sách
        </h2>
        <p class="text-muted mb-0">
            Tìm thấy <strong>@totalCount</strong> cuốn sách
            @if (!string.IsNullOrEmpty(keyword))
            {
                <span>cho từ khóa "<strong>@keyword</strong>"</span>
            }
            @if (categoryId > 0)
            {
                var cat = categories.FirstOrDefault(c => c.CategoryId == categoryId);
                if (cat != null)
                {
                    <span>trong danh mục "<strong>@cat.CategoryName</strong>"</span>
                }
            }
        </p>
    </div>

    @* ── Bộ lọc ── *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                @* Tìm kiếm *@
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="keyword" value="@keyword"
                               class="form-control border-start-0"
                               placeholder="Nhập tên sách, tác giả…" />
                    </div>
                </div>
                @* Lọc danh mục *@
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Danh mục</label>
                    <select name="categoryId" class="form-select">
                        <option value="0">-- Tất cả danh mục --</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.CategoryId"
                                    selected="@(categoryId == cat.CategoryId)">
                                @cat.CategoryName
                            </option>
                        }
                    </select>
                </div>
                @* Nút tìm / xóa lọc *@
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                    @if (!string.IsNullOrEmpty(keyword) || categoryId > 0)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
                            <i class="bi bi-x-lg me-1"></i>Xóa
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    @* ── Chip danh mục nhanh ── *@
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-action="Index" asp-route-keyword="@keyword"
           class="btn btn-sm @(categoryId == 0 ? "btn-primary" : "btn-outline-secondary")">
            Tất cả
        </a>
        @foreach (var cat in categories)
        {
            <a asp-action="Index"
               asp-route-categoryId="@cat.CategoryId"
               asp-route-keyword="@keyword"
               class="btn btn-sm @(categoryId == cat.CategoryId ? "btn-primary" : "btn-outline-secondary")">
                @cat.CategoryName
            </a>
        }
    </div>

    @* ── Lưới sách ── *@
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
            <p class="fs-5">Không tìm thấy sách nào.</p>
            <a asp-action="Index" class="btn btn-outline-primary mt-2">Xem tất cả sách</a>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var book in Model)
            {
                var available = (book.Quantity ?? 0) > 0 && book.Status == "Có thể mượn";
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm book-card">
                        @* Ảnh bìa *@
                        <a asp-action="Details" asp-route-id="@book.BookId" class="text-decoration-none">
                            <div class="book-cover-wrap">
                                @if (!string.IsNullOrEmpty(book.ImageUrl))
                                {
                                    <img src="@book.ImageUrl" alt="@book.Title"
                                         class="card-img-top book-cover" />
                                }
                                else
                                {
                                    <div class="book-cover-placeholder d-flex align-items-center
                                                justify-content-center bg-light">
                                        <i class="bi bi-book text-muted" style="font-size:3rem"></i>
                                    </div>
                                }
                                @* Badge trạng thái *@
                                @if (!available)
                                {
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2">
                                        Hết sách
                                    </span>
                                }
                            </div>
                        </a>
                        @* Thông tin *@
                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title fw-bold mb-1 text-truncate-2"
                                title="@book.Title">@book.Title</h6>
                            <p class="card-text text-muted small mb-1">
                                <i class="bi bi-person me-1"></i>@(book.Author ?? "Không rõ")
                            </p>
                            @if (book.BookCategories.Any())
                            {
                                <div class="mb-2">
                                    @foreach (var bc in book.BookCategories.Take(2))
                                    {
                                        <span class="badge bg-primary bg-opacity-10
                                                     text-primary me-1 small">
                                            @bc.Category?.CategoryName
                                        </span>
                                    }
                                </div>
                            }
                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@book.BookId"
                                   class="btn btn-sm btn-outline-primary flex-fill">
                                    <i class="bi bi-eye me-1"></i>Xem
                                </a>
                                @if (available)
                                {
                                    <a href="@Url.Action("CreateBorrowRequest", "Borrow",
                                                new { bookIds = book.BookId })"
                                       class="btn btn-sm btn-primary flex-fill">
                                        <i class="bi bi-bookmark-plus me-1"></i>Mượn
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* ── Phân trang ── *@
        @if (totalPages > 1)
        {
            <nav class="mt-4 d-flex justify-content-center">
                <ul class="pagination">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-keyword="@keyword"
                           asp-route-categoryId="@categoryId"
                           asp-route-page="@(currentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-keyword="@keyword"
                               asp-route-categoryId="@categoryId"
                               asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-keyword="@keyword"
                           asp-route-categoryId="@categoryId"
                           asp-route-page="@(currentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<style>
    .book-card { transition: transform .2s, box-shadow .2s; border-radius: 10px; overflow: hidden; }
    .book-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,.12) !important; }

    .book-cover-wrap { position: relative; height: 220px; overflow: hidden; background: #f8f9fa; }
    .book-cover { width: 100%; height: 100%; object-fit: cover; }
    .book-cover-placeholder { height: 100%; }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
