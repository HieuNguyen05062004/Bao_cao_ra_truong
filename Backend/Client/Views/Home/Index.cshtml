@using Core.Shared.Entities
@model List<Book>

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container mt-4">
    <!-- Hero Section -->
    <div class="row mb-5">
        <div class="col-md-12">
            <div class="bg-light p-5 rounded text-center">
                <h1 class="display-4">
                    <i class="fas fa-library"></i> Hệ thống quản lý thư viện
                </h1>
                <p class="lead text-muted">Khám phá hàng ngàn đầu sách hay tại thư viện của chúng tôi</p>
            </div>
        </div>
    </div>

    <!-- Thanh tìm kiếm -->
    <div class="row mb-4">
        <div class="col-md-8 offset-md-2">
            <form method="get" action="@Url.Action("Index", "Search")" class="row g-2">
                <div class="col-md-10">
                    <input type="text" name="searchTerm" class="form-control form-control-lg" 
                           placeholder="Tìm kiếm sách theo tên hoặc tác giả...">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="fas fa-search"></i> Tìm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Thể loại -->
    @if (ViewBag.Categories != null && ((List<Category>)ViewBag.Categories).Count > 0)
    {
        <div class="row mb-5">
            <div class="col-md-12">
                <h5 class="mb-3">Duyệt theo thể loại:</h5>
                <div class="d-flex flex-wrap gap-2">
                    <a href="@Url.Action("Index")" class="btn btn-outline-primary">
                        <i class="fas fa-list"></i> Tất cả
                    </a>
                    @foreach (var category in (List<Category>)ViewBag.Categories)
                    {
                        <a href="@Url.Action("Index", "Search", new { categoryId = category.CategoryId })" 
                           class="btn btn-outline-secondary">
                            @category.CategoryName
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Danh sách sách nổi bật -->
    <div class="row mb-4">
        <div class="col-md-12">
            <h4>
                <i class="fas fa-fire"></i> Sách nổi bật (Còn hàng)
            </h4>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="row">
            @foreach (var book in Model.Take(6))
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm hover-shadow">
                        @if (!string.IsNullOrEmpty(book.ImageUrl))
                        {
                            <img src="@book.ImageUrl" class="card-img-top" alt="@book.Title" 
                                 style="height: 250px; object-fit: cover; cursor: pointer;" 
                                 onclick="location.href='@Url.Action("Details", "Search", new { id = book.BookId })';">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" 
                                 style="height: 250px; cursor: pointer;" 
                                 onclick="location.href='@Url.Action("Details", "Search", new { id = book.BookId })';">
                                <i class="fas fa-book fa-4x text-muted"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">
                                @if (book.Title.Length > 50)
                                {
                                    @(book.Title.Substring(0, 50) + "...")
                                }
                                else
                                {
                                    @book.Title
                                }
                            </h5>
                            <p class="card-text text-muted">
                                <small>
                                    <i class="fas fa-pen"></i> @(book.Author ?? "-")
                                </small>
                            </p>
                            <p class="card-text text-muted">
                                <small>
                                    <i class="fas fa-tag"></i> @(book.Category?.CategoryName ?? "-")
                                </small>
                            </p>
                            <div class="mb-2">
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle"></i> Còn @book.Quantity
                                </span>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <a href="@Url.Action("Details", "Search", new { id = book.BookId })" 
                               class="btn btn-primary btn-sm w-100">
                                <i class="fas fa-eye"></i> Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.Count > 6)
        {
            <div class="row mt-4">
                <div class="col-md-12 text-center">
                    <a href="@Url.Action("Index", "Search")" class="btn btn-lg btn-outline-primary">
                        <i class="fas fa-search"></i> Xem tất cả sách
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-info-circle fa-3x mb-3"></i>
            <p>Hiện tại chưa có sách nào trong hệ thống</p>
        </div>
    }
</div>

<style>
    .hover-shadow {
        transition: all 0.3s ease;
    }

    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
</style>
